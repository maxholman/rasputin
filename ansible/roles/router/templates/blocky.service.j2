# Managed by Ansible. Edit the role, not this file.
[Unit]
Description=blocky DNS resolver
Documentation=https://0xerr0r.github.io/blocky/
# The listen addresses are the static LAN IPs, which dhcpcd assigns. Starting
# first means binding an address that does not exist yet.
After=network.target dhcpcd.service
Wants=network.target

[Service]
Type=simple
User={{ blocky_user }}
Group={{ blocky_user }}
ExecStart=/usr/local/bin/blocky serve --config /etc/blocky/config.d
ExecReload=/bin/kill -HUP $MAINPID

# Unprivileged, but :53 and :443 are privileged ports.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Never give up. On this box a dead resolver means no DNS for every client,
# and the usual cause is transient - a LAN address that dhcpcd has not
# assigned yet. StartLimitIntervalSec=0 disables the burst limit that would
# otherwise leave it failed after a few quick retries at boot.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StateDirectory=blocky

[Install]
WantedBy=multi-user.target
