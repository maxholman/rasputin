# Installed only while {{ eth_if }} is a LAN leg. When a profile makes it the
# uplink it is a DHCP client and this file is removed, so dnsmasq never answers
# DHCP on a venue's ethernet.
interface={{ eth_if }}
dhcp-range=set:lan,{{ eth_subnet }}.{{ eth_dhcp_start }},{{ eth_subnet }}.{{ eth_dhcp_end }},255.255.255.0,12h
# Point clients at THIS box, and only this box. tag:lan, so this can never be
# the answer for a client on the AP leg - see 20-wlan1-ap.conf.
dhcp-option=tag:lan,6,{{ eth_subnet }}.1
