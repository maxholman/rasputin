#!/usr/bin/env bash
# rasputin - declare a venue profile, then converge onto it.
#
#   rasputin <profile> which leg faces the venue, and whether a tunnel is
#                      required. {{ eth_if }} serves the wired network unless
#                      it IS the uplink; unplugged, it has nobody to serve.
#   rasputin status    show declared vs actual
#   rasputin converge  re-apply the declared mode (runs at boot)
#   rasputin refresh   re-apply the firewall for the uplink's current address
#   rasputin portal    open a bounded hole to clear a captive portal
#   rasputin mac-new   drop the pinned uplink MAC, take a fresh identity
#   rasputin join      put a venue's wifi in the supplicant config and join it
#   rasputin forget    remove a network join wrote
#
# Managed by Ansible. Edit the role, not this file.
set -euo pipefail

STATE_DIR=/etc/rasputin
STATE="$STATE_DIR/mode"
PORTAL_STATE="$STATE_DIR/portal"
MAC_PIN="$STATE_DIR/mac-pin"
PORTAL_TIMEOUT={{ portal_timeout | default(900) }}
PORTAL_URL=""
PORTAL_UPLINK=""
ETH={{ eth_if }}
AP={{ ap_if }}
WIFI={{ wan_wifi_if }}
ETH_NET={{ eth_subnet }}
AP_NET={{ ap_subnet }}
LAN_SNIPPET=/etc/dnsmasq.d/30-eth0-lan.conf
LAN_SOURCE=/usr/local/share/rasputin/30-eth0-lan.conf
DHCPCD=/etc/dhcpcd.conf
BEGIN='# >>> rasputin managed >>>'
END='# <<< rasputin managed <<<'

die() { printf 'rasputin: %b\n' "$*" >&2; exit 1; }

usage() { printf '%b\n' "usage: rasputin {{'{'}}{{ rasputin_profiles.keys()|join('|') }}|converge|refresh|confirm|status|portal|mac-new|join|forget{{'}'}}\n              [--rollback SECS] [--for SECS] [--check] [--scan]\n  profile = which leg faces the venue + whether a tunnel is required;\n            {{ eth_if }} serves the wired net unless it IS the uplink\n  refresh = re-apply the firewall for the uplink's current address\n  portal  = open a bounded hole to clear a captive portal (--check only probes)\n  mac-new = drop the pinned uplink MAC and take a fresh identity\n  join    = join a venue wifi: join <ssid> [passphrase], or --scan to list\n  forget  = drop a network that join wrote: forget <ssid>"; }

# Asking for a password in order to print the usage is the wrong first
# impression, and the one every new operator gets. Answered before sudo.
case "${1:-}" in ''|-h|--help|help) usage; [[ -n ${1:-} ]] && exit 0 || exit 1 ;; esac

# Re-enter through sudo rather than refusing, so `rasputin join` works the way
# it is written down. Always by absolute path, which is what the sudoers rule
# pins - being reached through the /usr/local/bin symlink must not change which
# path is checked. setuid is not the alternative: Linux ignores it on scripts.
[[ $EUID -eq 0 ]] || exec sudo /usr/local/sbin/rasputin "$@"

# --- the declared state ----------------------------------------------------
write_dhcpcd_block() {
  local mode="$1" tmp
  tmp=$(mktemp)
  sed "/^${BEGIN}$/,/^${END}$/d" "$DHCPCD" > "$tmp"
  {
    echo "$BEGIN"
    echo "# Generated by rasputin. Mode: $mode"
    echo ""
    echo "# ${WIFI} is always a client and is the only interface permitted a gateway."
    echo "interface ${WIFI}"
    echo "gateway"
    echo ""
    echo "# ${AP} is always the AP. Constant in both modes. LAN => never a gateway."
    echo "interface ${AP}"
    echo "static ip_address=${AP_NET}.1/24"
    echo "nogateway"
    echo ""
    if [[ $mode == serve ]]; then
      echo "# ${ETH} serves the wired net. Deliberately NO 'static routers=' line:"
      echo "# a self-pointing gateway here black-holes all forwarded traffic."
      echo "interface ${ETH}"
      echo "static ip_address=${ETH_NET}.1/24"
      echo "nogateway"
    else
      echo "# ${ETH} is the uplink: plain DHCP client, gateway accepted from the venue."
      echo "interface ${ETH}"
      echo "gateway"
    fi
    echo "$END"
  } >> "$tmp"
  install -m 0644 "$tmp" "$DHCPCD"; rm -f "$tmp"
}

# --- firewall -------------------------------------------------------------
# Admin (SSH) and DNS are bound to whatever is LAN *in this mode*, never to the
# uplink. On a travel router the uplink is hostile by definition.
apply_firewall() {
  local uplink="$1" mode="$2" vpn="${3:-0}" portal="${4:-0}" lan_list admin_list egress
  # THE KILL SWITCH. With the VPN up, the tunnel is the only permitted exit.
  # If wg0 disappears, no forward rule matches and policy drop takes over -
  # clients lose connectivity rather than silently egressing in the clear.
  if [[ $vpn == 1 ]]; then egress="$VPN_IF"; else egress="$uplink"; fi
  if [[ $mode == serve ]]; then lan_list="\"$ETH\", \"$AP\""; else lan_list="\"$AP\""; fi
  admin_list="$lan_list"
{% if admin_on_uplink | default(false) | bool %}
  admin_list="$admin_list, \"$uplink\""   # admin_on_uplink=true: EXPOSES SSH TO THE VENUE
{% endif %}

  sysctl -qw net.ipv4.ip_forward=1

  # Never accept Router Advertisements on a hostile uplink: a spoofed RA
  # installs an IPv6 default route + RDNSS, and RFC 6724 makes IPv6 win over
  # our IPv4 path. This is the highest-value attack on this box at a venue.
  # all/default matter as much as the uplink: with them left at 1 a rogue
  # client on our OWN LAN can RA us a default route. Demonstrated, not theory.
  sysctl -qw net.ipv6.conf.all.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.default.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.all.autoconf=0 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.accept_ra=0" 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.autoconf=0" 2>/dev/null || true
  # We do not advertise IPv6 to clients, so forwarding it would only create
  # a path with no return route. Explicit beats inherited.
  sysctl -qw net.ipv6.conf.all.forwarding=0 2>/dev/null || true

  # The venue's own subnet and gateway. Clients must not reach other guests,
  # but MUST still reach the gateway itself or captive-portal login is
  # impossible - portals almost always sit on a private address there.
  local upnet upgw lateral=""
  # Wait for the uplink to actually have an address. apply_firewall runs
  # milliseconds after dhcpcd is bounced, so without this the lookups return
  # empty on the COMMON path and every anti-lateral rule silently vanishes.
  local _i
  for _i in $(seq 1 15); do
    upnet=$(ip -4 -o addr show dev "$uplink" 2>/dev/null | awk '{print $4}' | head -1)
    [[ -n "$upnet" ]] && break
    sleep 1
  done
  # "$3" is the gateway only for "default via X dev Y". On a point-to-point
  # uplink (LTE/tether: "default dev wwan0 scope link") $3 is the INTERFACE
  # NAME, which nft then tries to resolve as a hostname and the load fails.
  upgw=$(ip -4 route show default dev "$uplink" 2>/dev/null \
         | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
  if [[ -n "$upnet" ]]; then
    # With the profile demanding the tunnel there is no legitimate reason for a
    # client to talk to the venue gateway in the clear: converge refuses to arm
    # the switch behind a portal, and a portal that appears later is what
    # `rasputin portal` is for. Leaving the exception open would be a hole
    # straight through the kill switch to a venue-controlled device.
    if [[ -n "$upgw" && $vpn != 1 ]]; then
      # Only the ports a captive portal needs. A blanket accept here would let
      # SMB and mDNS reach the venue's own gateway - the exact inventory leak
      # the discovery drops below exist to prevent.
      lateral="    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport { 80, 443 } accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw udp dport 53 accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport 53 accept
"
    elif [[ $vpn == 1 ]]; then
      echo "rasputin: captive-portal exception withheld - this profile sends clients through $VPN_IF; a login page is reached with: rasputin portal" >&2
    else
      echo "rasputin: WARNING - no gateway on $uplink; captive portals will be unreachable" >&2
    fi
    lateral="${lateral}    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upnet drop"
  else
    echo "rasputin: WARNING - $uplink has no address; venue-lateral rules NOT installed" >&2
  fi

  # Portal mode swaps the blanket "anything out the uplink" accept for a
  # web-only one. The venue-subnet drop above still stands, so the other guests
  # stay unreachable for the whole time the login page is open - the hole is in
  # what protocols may leave, never in who may be reached.
  local egress_rule="    iifname @lan_ifaces oifname \"$egress\" accept"
  if [[ $portal == 1 ]]; then
    egress_rule="    # CAPTIVE PORTAL MODE: web only, and only long enough to log in.
    iifname @lan_ifaces oifname \"$uplink\" tcp dport { 80, 443 } accept"
  fi
  # THE OTHER HALF OF THE KILL SWITCH. The forward chain stops CLIENTS leaking
  # when the tunnel drops; nothing stopped traffic this box originates itself.
  # That was survivable only while the resolver's upstream was an address that
  # exists solely inside the tunnel. It is a DoH endpoint on the public
  # internet now, so a dead wg0 would leave the resolver quietly querying it
  # out of the venue's uplink - the leak the client-side switch cannot see.
  local output_policy="accept" output_rules=""
{% if killswitch_restrict_output | default(true) | bool %}
  if [[ $vpn == 1 ]]; then
    local wgep wgip wgport
    # Read the peer from the LIVE interface, not the config file: wg-quick has
    # already resolved and applied it, and this cannot disagree with what the
    # kernel is actually sending to.
    wgep=$(wg show "$VPN_IF" endpoints 2>/dev/null | awk '{print $2}' | head -1)
    wgip=${wgep%:*}; wgport=${wgep##*:}
    # IPv4 only, and validated: an IPv6 endpoint arrives as [addr]:port and
    # would render an "ip daddr [2001:...]" rule that nft refuses to load.
    if [[ $wgip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ && $wgport =~ ^[0-9]+$ ]]; then
      output_policy="drop"
      output_rules="    oif lo accept
    ct state established,related accept
    oifname \"$VPN_IF\" accept
    oifname @lan_ifaces accept
    # The handshake that keeps the tunnel alive must survive the chain that
    # insists on the tunnel, or a single dropped keepalive is unrecoverable.
    oifname \"$uplink\" ip daddr $wgip udp dport $wgport accept
    # dhcpcd lease renewal on the venue's uplink.
    oifname \"$uplink\" udp sport 68 udp dport 67 accept
    icmp type { destination-unreachable, time-exceeded } accept"
    else
      # Fail open, loudly, rather than strand the box: we are already past
      # vpn_start, so dropping the handshake would kill the tunnel that the
      # forward chain requires and take everything with it.
      echo "rasputin: WARNING - no usable $VPN_IF peer endpoint ($wgep); output kill switch NOT installed" >&2
    fi
  fi
{% endif %}
  cat > "$STATE_DIR/ruleset.nft" <<NFT
table inet rasputin
delete table inet rasputin
table inet rasputin {
  set lan_ifaces   { type ifname; elements = { $lan_list } }
  set admin_ifaces { type ifname; elements = { $admin_list } }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    # Path MTU discovery must survive on every interface or large responses
    # hang - especially behind WireGuard.
    icmp type { destination-unreachable, time-exceeded } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

    # Neighbour discovery is required for IPv6 to function at all.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept

    # Answer pings only on our own LANs. On the venue's network we stay dark.
    iifname @lan_ifaces icmp type echo-request accept
    # nd-router-advert accepted NOWHERE: we are the router, we are never told a route.
    iifname @lan_ifaces icmpv6 type { echo-request, nd-router-solicit } accept
    # NOTE: nd-router-advert is deliberately NOT accepted on the uplink.

    # DHCP + DNS: LAN legs only. Never an open resolver on the venue's wifi.
    iifname @lan_ifaces udp dport { 67, 53 } accept
    iifname @lan_ifaces tcp dport 53 accept
{% if blocky_doh_cert is defined and blocky_doh_key is defined %}
    # DoH, under exactly the same LAN-only rule as plain DNS. Binding the
    # listener is not enough - without this the input policy silently drops it
    # and the port looks open from the box but dead from every client.
    iifname @lan_ifaces tcp dport {{ blocky_doh_port }} accept
{% endif %}

    # DHCP client on the uplink. dhcpcd's initial handshake uses AF_PACKET and
    # bypasses netfilter, but broadcast replies and its UDP fallback do not.
    iifname "$uplink" udp sport 67 udp dport 68 accept

    # Admin plane.
    iifname @admin_ifaces tcp dport 22 accept
    # everything else, notably anything arriving on the uplink, hits policy drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    # MUST sit above the ct rule: the server's SYN-ACK is already ESTABLISHED,
    # so below it only the client's SYN gets clamped and the return direction
    # stays unclamped - half-fixing the blackhole this exists to prevent.
    tcp flags syn tcp option maxseg size set rt mtu
    ct state established,related accept
    ct state invalid drop
    # Lateral movement: reach the venue gateway (captive portal) but not the
    # other guests sharing that subnet.
$lateral
    iifname @lan_ifaces oifname "$uplink" ip daddr 169.254.0.0/16 drop

    # Unicast discovery only. Multicast never enters the forward hook at all
    # (no multicast routing), so these catch unicast mDNS/SSDP/NetBIOS - a
    # narrower leak than it looks, but a real one.
    iifname @lan_ifaces oifname "$uplink" udp dport { 5353, 5355, 1900, 137, 138 } drop
    iifname @lan_ifaces oifname "$uplink" tcp dport { 139, 445 } drop

$egress_rule
    iifname @lan_ifaces oifname @lan_ifaces accept
    # uplink -> LAN is only ever reply traffic, matched by the ct rule above
  }

  chain postrouting {
    type nat hook postrouting priority srcnat;
    oifname "$egress" masquerade
  }

  # Router-originated traffic. Wide open unless the profile demands a tunnel,
  # in which case wg0 is the only way out for this box too.
  chain output {
    type filter hook output priority 0; policy $output_policy;
$output_rules
  }
}
NFT

  # RaspAP left a blanket "-A POSTROUTING -j MASQUERADE" in the ip nat table.
  # It NATs out WHATEVER interface traffic takes, so the moment a tunnel drops
  # clients keep browsing straight out the venue's wifi, unprotected. A kill
  # switch cannot work while it exists. Docker's own rule is scoped with -s and
  # is left alone; we only remove unscoped blanket rules.
  while iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null; do
    iptables -t nat -D POSTROUTING -j MASQUERADE || break
    echo "rasputin: removed a blanket iptables MASQUERADE (kill-switch prerequisite)"
  done

  # Validate before loading. A bad ruleset must never reach the kernel.
  if ! nft -c -f "$STATE_DIR/ruleset.nft"; then
    echo "rasputin: nftables ruleset invalid; firewall unchanged" >&2
    return 1
  fi
  nft -f "$STATE_DIR/ruleset.nft"
}

# --- the guard that today's outage earned ----------------------------------
assert_sane() {
  local mode="$1" lans=() bad=0
  if [[ $mode == serve ]]; then lans=("$ETH" "$AP"); else lans=("$AP"); fi
  for lan in "${lans[@]}"; do
    if ip route show default | grep -q "dev ${lan}\b"; then
      echo "rasputin: FATAL - default route points out LAN interface ${lan}" >&2
      bad=1
    fi
  done
  [[ $bad -eq 0 ]] || die "refusing to leave the box in a black-holed state"
  ip route show default | grep -q . || echo "rasputin: WARNING - no default route at all"
}

# --- lockout insurance ------------------------------------------------------
# Tightening the admin plane remotely can strand you. Schedule a transient
# timer that tears the firewall back down; `rasputin confirm` cancels it.
schedule_rollback() {
  local secs="$1"
  # Must be whole seconds. "--rollback 5m" would otherwise reach systemd as
  # --on-active=5ms and revert the firewall before it had finished applying.
  case "$secs" in ''|*[!0-9]*) die "--rollback takes whole seconds, got: $secs" ;; esac
  [ "$secs" -ge 30 ] || die "--rollback must be at least 30s, got: $secs"

  # A pending timer would make systemd-run fail on the unit name, aborting a
  # converge that has already rewritten dhcpcd and dnsmasq.
  systemctl stop rasputin-rollback.timer 2>/dev/null || true
  systemctl reset-failed rasputin-rollback.service 2>/dev/null || true
  rm -f "$STATE_DIR/rollback-fired"

  systemd-run --quiet --unit=rasputin-rollback --on-active="${secs}s" \
    /usr/local/sbin/rasputin rollback-fire \
    || die "could not schedule rollback; refusing to change the firewall blind"
  echo "rasputin: firewall rolls back in ${secs}s - run 'rasputin confirm' to keep it"
}

# Runs from the timer. Leaves a marker so `confirm` can distinguish "never
# armed" from "already fired and destroyed your firewall".
rollback_fire() {
  nft delete table inet rasputin 2>/dev/null || true
  date -Is > "$STATE_DIR/rollback-fired"
  echo "rasputin: ROLLBACK FIRED - firewall removed" >&2
}

cancel_rollback() {
  if [[ -f "$STATE_DIR/rollback-fired" ]]; then
    echo "rasputin: ROLLBACK ALREADY FIRED at $(cat "$STATE_DIR/rollback-fired")" >&2
    echo "rasputin: the firewall was removed. Re-run 'rasputin $(cat "$STATE" 2>/dev/null || echo serve)' to restore it." >&2
    return 1
  fi
  if systemctl stop rasputin-rollback.timer 2>/dev/null; then
    echo "rasputin: rollback cancelled, ruleset kept"
  else
    echo "rasputin: no rollback was pending"
  fi
}

# A locally-administered, unicast MAC. Only ever applied to the interface
# facing the venue - never to a LAN leg, where a changing MAC would break
# every client's ARP cache and our own DHCP reservations.
set_mac() {
  local ifc="$1" mac="$2" rc=0
  ip link set dev "$ifc" down 2>/dev/null || true
  ip link set dev "$ifc" address "$mac" 2>/dev/null || rc=1
  ip link set dev "$ifc" up 2>/dev/null || true
  return $rc
}

randomize_mac() {
  local ifc="$1" mac
  mac=$(printf '02:%02x:%02x:%02x:%02x:%02x' \
        $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
  if set_mac "$ifc" "$mac"; then
    echo "rasputin: $ifc MAC randomised to $mac"
  else
    echo "rasputin: WARNING - could not randomise MAC on $ifc" >&2
  fi
}

WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf

# wpa_supplicant applies its OWN per-ESS randomisation (mac_addr=1) at
# association time, and it overwrites whatever `ip link set address` put there.
# Proven on this hardware: a converge set 02:c7:fc:e9:3d:56 and the interface
# came up wearing 8a:db:56:49:f7:6f. So holding a MAC means turning that off
# for as long as the pin lasts, and turning it back on when the pin is dropped.
# With mac_addr=0 the supplicant leaves an externally-set address alone - it
# does NOT restore the permanent one, which was the risk worth testing.
# Both keys, because either one alone still moves the address:
# preassoc_mac_addr randomises for the SCAN, and whatever it leaves on the
# interface is what mac_addr=0 then politely declines to change. Turning off
# only mac_addr buys an address that is stable until the next scan, which is
# not stable.
WPA_RANDOM_KEYS='mac_addr preassoc_mac_addr'

# The same test set_wpa_randomisation uses to decide it has nothing to do,
# separated out so a caller can ask the question without also answering it -
# the difference between "already off" and "just turned off" is a supplicant
# restart, and that is a dropped uplink.
wpa_randomisation_is() {
  local want="$1" k
  [[ -f $WPA_CONF ]] || return 1
  for k in $WPA_RANDOM_KEYS; do
    [[ $(grep -c "^${k}=" "$WPA_CONF") -eq 1 ]] || return 1
    grep -q "^${k}=${want}$" "$WPA_CONF" || return 1
  done
}

set_wpa_randomisation() {
  local want="$1" k   # 1 = supplicant randomises per ESS; 0 = rasputin owns the MAC
  [[ -f $WPA_CONF ]] || return 0
  wpa_randomisation_is "$want" && return 0
  # Delete-then-insert rather than substitute: a config carrying both
  # mac_addr=0 and mac_addr=1 is ambiguous about which wins. Collapsing to
  # exactly one is the point, not just setting the value.
  for k in $WPA_RANDOM_KEYS; do
    sed -i "/^${k}=/d" "$WPA_CONF"
    sed -i "1i ${k}=${want}" "$WPA_CONF"
  done
}

# A captive portal authorises a MAC ADDRESS, not a person. Randomising on the
# converge that follows would throw away the login you just completed, so
# `rasputin portal` pins whatever MAC cleared the portal and every converge
# after it holds that MAC until `rasputin mac-new` releases it. With no pin
# this is the old behaviour exactly: arriving somewhere is when a new identity
# is wanted, and every converge takes one.
# A pin is an identity some venue's portal authorised, and it must not outlive
# that venue: worn into the next one it links the two together, which is the
# correlation the randomisation exists to prevent. The SSID it was taken on is
# recorded beside it and checked here, while the supplicant is still running -
# apply_uplink_mac runs with it stopped and cannot ask.
drop_stale_mac_pin() {
  local p_if p_mac p_ssid now
  [[ -f $MAC_PIN ]] || return 0
  read -r p_if p_mac p_ssid < "$MAC_PIN" || return 0
  [[ $p_if == "$WIFI" && -n $p_ssid && $p_ssid != "-" ]] || return 0
  now=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^ssid=//p') || true
  [[ -n $now && $now != "$p_ssid" ]] || return 0
  rm -f "$MAC_PIN"
  echo "rasputin: dropped the MAC pinned on \"$p_ssid\" - this is \"$now\", a different network"
}

apply_uplink_mac() {
  local ifc="$1" p_if p_mac p_ssid
  if [[ -f $MAC_PIN ]] && read -r p_if p_mac p_ssid < "$MAC_PIN" && [[ $p_if == "$ifc" ]]; then
    # Must happen before reassociate_wifi restarts the supplicant, or the
    # supplicant re-randomises and the pin is silently discarded.
    [[ $ifc == "$WIFI" ]] && set_wpa_randomisation 0
    if set_mac "$ifc" "$p_mac"; then
      echo "rasputin: $ifc MAC held at $p_mac (pinned - a portal authorised it)"
      return 0
    fi
    echo "rasputin: WARNING - could not restore pinned MAC $p_mac on $ifc" >&2
  fi
  [[ $ifc == "$WIFI" ]] && set_wpa_randomisation 1
  randomize_mac "$ifc"
}

# wlan0's randomisation is undone by the AP beside it: hostapd has no bssid=
# line, so it beacons from wlan1's hardware address, and a controller that logs
# neighbouring BSSIDs sees the same one at every venue - next to a client MAC
# that changes, which is worse than not randomising, because it links them.
#
# Before hostapd rather than in converge: converge runs long after the AP is
# up, and changing the address underneath it would drop every client. Saved
# networks key on SSID, so a new BSSID at boot costs one reconnect, which is
# also what a reboot costs anyway.
ap_mac_new() {
{% if randomize_ap_mac | default(true) | bool %}
  local i
  # The AP is a USB dongle and boot beats its enumeration: measured, wlan1 did
  # not exist 7s in, and hostapd's own first start failed on "No such device"
  # two seconds later and recovered only on its restart. Waiting here is what
  # makes the randomisation land, and because hostapd is ordered after this it
  # stops that first failure happening at all.
  for i in $(seq 1 {{ ap_device_timeout | default(20) }}); do
    [[ -e "/sys/class/net/$AP" ]] && break
    sleep 1
  done
  if [[ ! -e "/sys/class/net/$AP" ]]; then
    echo "rasputin: WARNING - $AP never appeared; leaving the AP to hostapd" >&2
    return 0
  fi
  # Never fatal. This runs Before=hostapd.service, and an AP that does not come
  # up is the one failure with no way back in - a predictable address is the
  # lesser problem by a wide margin.
  randomize_mac "$AP" || true
{% else %}
  :
{% endif %}
}

# The permanent address is the one identity that follows this box to every
# venue, and it is on the air the moment a frame is sent - a scan, an
# association, a portal login - not when a profile is declared. Anything about
# to transmit somewhere new checks for it first. iproute2 prints `permaddr`
# only while the interface wears something else, so its absence is the test.
wears_permanent_mac() {
  ! ip -o link show dev "$WIFI" 2>/dev/null | grep -q ' permaddr '
}

# Randomise before the first frame. Costs a supplicant restart, because its
# randomisation keys are read at startup only - and the supplicant must be
# stopped across the change or it re-randomises over the new address itself.
shed_permanent_mac() {
{% if randomize_client_mac | default(true) | bool %}
  wears_permanent_mac || return 0
  echo "rasputin: $WIFI is wearing its permanent address - taking a random one before this network sees it"
  supplicant stop
  set_wpa_randomisation 1
  randomize_mac "$WIFI"
  supplicant start
  local i
  for i in $(seq 1 10); do
    wpa_cli -i "$WIFI" status >/dev/null 2>&1 && return 0
    sleep 1
  done
{% endif %}
  return 0
}

pin_uplink_mac() {
  local ifc="$1" mac ssid="-"
  mac=$(cat "/sys/class/net/$ifc/address" 2>/dev/null) || return 0
  # Recorded so the pin can be recognised as belonging to somewhere else later.
  # The SSID goes last because it may contain spaces.
  if [[ $ifc == "$WIFI" ]]; then
    ssid=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^ssid=//p') || true
    [[ -n $ssid ]] || ssid="-"
  fi
  echo "$ifc $mac $ssid" > "$MAC_PIN"
  echo "rasputin: $ifc MAC $mac pinned - 'rasputin mac-new' takes a fresh one"
}

# Both halves of the MAC story live here. wpa_supplicant's mac_addr=1 DOES work
# on this hardware (measured), so it, not `ip link set address`, is what
# normally decides the address - rasputin only takes over when a pin is held.
# The INSTANCE unit owns the association (-c ...-wlan0.conf -i wlan0). On this
# image the plain wpa_supplicant.service is the D-Bus daemon (-u -s -O) and
# touching it does not affect wlan0 at all.
supplicant() {
  systemctl "$1" "wpa_supplicant@${WIFI}" 2>/dev/null \
    || systemctl "$1" wpa_supplicant 2>/dev/null || true
}

# Waits for the supplicant to associate AND take a lease. The MAC is only
# settled once associated: preassoc_mac_addr=1 randomises during the scan, so
# sampling earlier reports an address the interface is about to stop wearing.
reassociate_wifi() {
  local i nudged=0
  for i in $(seq 1 {{ wifi_reassociate_timeout | default(45) }}); do
    # 169.254 is dhcpcd giving up, not an address - see wait_for_v4.
    if [[ -n "$(ip -4 -o addr show dev "$WIFI" 2>/dev/null | awk '$4 !~ /^169\.254\./')" ]]; then
      echo "rasputin: $WIFI reassociated as $(cat /sys/class/net/$WIFI/address)"
      return 0
    fi
    # One nudge, once associated, for the case where dhcpcd is still holding
    # the previous network's lease. Not one per second: `dhcpcd -n` is a REBIND,
    # and a venue with a second DHCP server answers a rebind for a lease it did
    # not grant with a NAK - measured 2026-09-05, 10.0.64.2 taking away what
    # 10.0.64.1 had just leased, once a second, for a minute, with the firewall
    # rebuilding itself behind every change.
    if (( ! nudged )) && [[ $(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^wpa_state=//p') == COMPLETED ]]; then
      dhcpcd -n "$WIFI" >/dev/null 2>&1 || true
      nudged=1
    fi
    sleep 1
  done
  echo "rasputin: WARNING - $WIFI has no address after MAC change" >&2
}

# --- joining a venue network ----------------------------------------------
# Nothing in the role declares network={} blocks, so before this the only way
# onto a venue's wifi was hand-editing WPA_CONF as root on a box whose uplink
# is by definition not working yet - the worst possible moment to be writing
# config from memory. This is that edit, made once and tested.
#
# Blocks written here are fenced by markers naming their SSID. Anything
# outside a fence belongs to someone else - the home hotspot's block predates
# this tool and is declared nowhere - so join replaces only its own fence and
# never rewrites the file wholesale.
JOIN_TAG='rasputin network'
join_begin() { printf '# >>> %s: %s >>>' "$JOIN_TAG" "$1"; }
join_end()   { printf '# <<< %s: %s <<<' "$JOIN_TAG" "$1"; }

# Exact string comparison against the fence lines rather than a sed range: an
# SSID is arbitrary text off a hotel card, and as a sed address one carrying
# regex metacharacters would delete the wrong lines or fail to compile at all.
# The fences are not guaranteed to survive. wpa_supplicant rewrites this file
# itself whenever update_config is on - the image ships it on - and its
# canonical form carries no comments at all, so a block join wrote can end up
# present but unfenced. Refusing to touch it then would leave the way out
# broken at exactly the venue that needed it, so ownership falls back to the
# ssid field, which is the thing the operator actually named.
#
# Buffered rather than streamed because the ssid line comes after the opening
# brace: the decision to keep a block cannot be made until its closing one.
wpa_strip_ssid_block() {
  awk -v want="$1" '
    /^[[:space:]]*network[[:space:]]*=[[:space:]]*{/ { inb = 1; buf = $0 ORS; hit = 0; next }
    inb {
      buf = buf $0 ORS
      if ($0 ~ /^[[:space:]]*ssid="/) {
        v = $0
        sub(/^[[:space:]]*ssid="/, "", v)
        sub(/"[[:space:]]*$/, "", v)
        if (v == want) hit = 1
      }
      if ($0 ~ /^[[:space:]]*}[[:space:]]*$/) { if (!hit) printf "%s", buf; inb = 0 }
      next
    }
    { print }
  ' "$2"
}

wpa_has_ssid_block() {
  awk -v want="$1" '
    /^[[:space:]]*ssid="/ {
      v = $0
      sub(/^[[:space:]]*ssid="/, "", v)
      sub(/"[[:space:]]*$/, "", v)
      if (v == want) { found = 1 }
    }
    END { exit !found }
  ' "$2"
}

wpa_strip_block() {
  awk -v b="$(join_begin "$1")" -v e="$(join_end "$1")" '
    $0 == b { inside = 1 }
    !inside { print }
    $0 == e { inside = 0 }
  ' "$2"
}

# wpa_passphrase derives the 256-bit key so the venue passphrase is not left
# in the config in clear. Its own output also echoes the plaintext back on a
# `#psk=` comment line, which would defeat the exercise entirely - so take the
# derived line and nothing else.
wpa_derive_psk() {
  local out
  out=$(wpa_passphrase "$1" "$2" 2>&1) || die "wpa_passphrase rejected that passphrase"
  printf '%s' "$out" | grep -oE '^[[:space:]]*psk=[0-9a-f]{64}$' | tr -d '[:space:]'
}

join_network() {
  local ssid="${1:-}" pass="${2:-}" tmp top priority psk kind n
  [[ -n $ssid ]] || die "join needs an SSID:\n  rasputin join <ssid> [passphrase]\n  rasputin join --scan   (list what is on the air)"
  # An unquoted multi-word SSID otherwise arrives as several operands and the
  # second word is silently taken for the passphrase - joining the wrong
  # network with the wrong key, and then blaming the key.
  (( $# <= 2 )) || die "join takes one SSID and one optional passphrase.\n  quote a name with spaces in it: rasputin join \"Hotel Guest WiFi\""
  [[ -f $WPA_CONF ]] || die "$WPA_CONF is missing - nothing to join into"
  # wpa_supplicant has escaping rules for these inside a quoted ssid, and a
  # venue whose SSID needs them is rare enough that guessing wrong - and
  # silently never associating - is the worse outcome than refusing here.
  [[ $ssid != *'"'* && $ssid != *'\'* ]] || die "SSIDs containing quotes or backslashes must be added by hand"
  # A newline would close the ssid line and let the remainder of the argument
  # land in the config as directives of its own.
  [[ $ssid != *[[:cntrl:]]* ]] || die "SSIDs cannot contain control characters"
  # 802.11 caps an SSID at 32 BYTES, and wpa_supplicant rejects the ENTIRE
  # config over one oversized block, not merely that network. Unchecked, this
  # writes a file the supplicant cannot parse, which costs the uplink at the
  # next boot. Bytes, not characters: a 12-character CJK name is 36 of them.
  n=$(printf '%s' "$ssid" | wc -c)
  (( n <= 32 )) || die "SSIDs are limited to 32 bytes - that one is $n"

  # Before anything else touches the air. A box powered on at the venue still
  # declaring `home` has been probing with its real address since boot; this
  # is the first command that can stop it.
  shed_permanent_mac

  kind=open
  if [[ -n $pass ]]; then
    kind=WPA2
    # WPA's own limit. Checked here so the error names the actual problem
    # instead of relaying wpa_passphrase's rather less obvious complaint.
    n=${{'{'}}#pass}
    (( n >= 8 && n <= 63 )) || die "WPA passphrases are 8-63 characters - that one is $n"
    psk=$(wpa_derive_psk "$ssid" "$pass") || true
    [[ -n $psk ]] || die "could not derive a key for \"$ssid\""
  fi

  # Alongside the target rather than in /tmp: the replacement below has to be a
  # rename within one filesystem to be atomic. Copying leaves a window where
  # the supplicant's only config is absent or half-written.
  tmp=$(mktemp "${WPA_CONF}.rasputin.XXXXXX")
  wpa_strip_block "$ssid" "$WPA_CONF" > "$tmp"
  # Anything left declaring the same SSID would be a second, competing block:
  # the supplicant honours both, and which one wins is not ours to predict.
  if wpa_has_ssid_block "$ssid" "$tmp"; then
    echo "rasputin: replacing an existing declaration of \"$ssid\""
    wpa_strip_ssid_block "$ssid" "$tmp" > "$tmp.2" && mv -f "$tmp.2" "$tmp"
  fi

  # Outrank everything already declared. At a venue the phone hotspot is in
  # your pocket and therefore in range, and with nothing to separate them the
  # supplicant is free to prefer it - spending exactly the mobile data that
  # using the venue's wifi is meant to save. Read after the strip, so
  # re-joining one SSID reclaims its old slot instead of ratcheting upwards.
  top=$(grep -hoE '^[[:space:]]*priority=[0-9]+' "$tmp" | grep -oE '[0-9]+' | sort -n | tail -1) || true
  # 10# because a hand-written priority=09 is a typo, not octal, and letting
  # bash reject it as a bad number aborts the run mid-write.
  priority=$(( 10#${top:-0} + 1 ))

  {
    join_begin "$ssid"; echo
    echo "# Written by 'rasputin join'. Drop it with 'rasputin forget'."
    echo "network={"
    printf '\tssid="%s"\n' "$ssid"
    if [[ -n $pass ]]; then
      printf '\t%s\n' "$psk"
    else
      # Saying this explicitly is required, not tidiness: with no key_mgmt the
      # supplicant assumes WPA-PSK, finds no key and never associates. An open
      # SSID is the normal shape of hotel wifi - the authentication there is
      # the captive portal, not the link.
      printf '\tkey_mgmt=NONE\n'
    fi
    printf '\tpriority=%s\n' "$priority"
    echo "}"
    join_end "$ssid"; echo
  } >> "$tmp"

  chmod 0600 "$tmp"; mv -f "$tmp" "$WPA_CONF"
  # Joining somewhere is arriving somewhere, and the pinned identity belongs to
  # wherever we were before.
  if [[ -f $MAC_PIN ]]; then
    rm -f "$MAC_PIN"
    echo "rasputin: dropped the pinned MAC - a new network gets a new identity"
  fi
  echo "rasputin: wrote network block for \"$ssid\" ($kind, priority $priority)"
  wpa_apply "$ssid"
}

# `wpa_cli reconfigure` re-reads the file in place. It is not seamless - the
# supplicant deauthenticates and rescans on every reload, so the uplink blips
# either way - but a full restart additionally hands a pinned MAC back to the
# supplicant's own randomisation before the pin can be re-asserted.
wpa_apply() {
  local want="$1" i state ssid addr reply
  # wpa_cli exits 0 even when the daemon answers FAIL, so its status says
  # nothing: the answer has to be read. FAIL means the file did not parse, and
  # one bad block rejects the WHOLE config - the running daemon keeps its old
  # copy, so nothing looks wrong until the next boot comes up with no uplink.
  reply=$(wpa_cli -i "$WIFI" reconfigure 2>/dev/null) || reply=""
  case "$reply" in
    OK*) ;;
    FAIL*)
      forget_network "$want" >/dev/null 2>&1 || true
      die "the supplicant refused to parse its config with \"$want\" in it.\n  the block has been removed again, so the uplink still comes up at boot.\n  report this: the SSID passed every check and should have been representable." ;;
    *) die "the block is written, but wpa_cli could not reach the supplicant on $WIFI.\n  it will be picked up by: systemctl restart wpa_supplicant@$WIFI" ;;
  esac

  for i in $(seq 1 {{ wifi_reassociate_timeout | default(45) }}); do
    # A rejected network does not fail, it retries - the supplicant parks it as
    # TEMP-DISABLED and says nothing. Waiting out the full timeout to report
    # "did not associate" would name the wrong problem.
    #
    # Matched on the ssid COLUMN: a substring test fires on "Hotel-Staff" while
    # you are joining "Hotel", and blames the network you are actually using.
    if wpa_cli -i "$WIFI" list_networks 2>/dev/null \
         | awk -F'\t' -v s="$want" 'NR>1 && $2==s && $4 ~ /TEMP-DISABLED/ {hit=1} END{exit !hit}'; then
      forget_network "$want" >/dev/null 2>&1 || true
      die "\"$want\" refused us - the supplicant has parked it as TEMP-DISABLED.\n  a wrong passphrase is the usual cause; an AP that accepts the key and then\n  times out looks the same. the block has been removed again.\n  retry with: rasputin join \"$want\" <passphrase>"
    fi
    state=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^wpa_state=//p')
    ssid=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^ssid=//p')
    if [[ $state == COMPLETED && $ssid == "$want" ]]; then
      # Associated is not online. dhcpcd rebinds on the carrier change by
      # itself; the nudge is for the case where it is still holding the
      # previous network's lease, which looks identical from up here.
      dhcpcd -n "$WIFI" >/dev/null 2>&1 || true
      # || true, because under set -e a failing command substitution takes the
      # whole script with it and the diagnosis below never gets to print.
      addr=$(wait_for_v4 "$WIFI") || true
      if [[ -z $addr ]]; then
        # Leave nothing worse than we found it. The block just written outranks
        # every other network, so keeping one that leases nothing means the next
        # boot prefers a dead uplink over the hotspot that actually works - and
        # a venue is where that is least survivable.
        forget_network "$want" >/dev/null 2>&1 || true
        die "associated to \"$want\", but its DHCP never answered.\n  no usable address, so it has been dropped again and the previous network is back.\n  if the venue is merely slow, retry: rasputin join \"$want\""
      fi
      echo "rasputin: associated to \"$want\", $addr on $WIFI"
      # Associating proves the link and nothing beyond it. At a hotel that is
      # usually not the same as being online, and one HTTP request is what
      # separates "connected" from "sitting behind a login page".
      portal_check || true
      echo "rasputin: declare a profile to use it: {{ rasputin_profiles.keys()|join(', ') }}"
      return 0
    fi
    sleep 1
  done
  # Running out of loop is not proof of failure. wpa_cli renders every byte
  # >= 0x7f as \xNN, so a non-ASCII SSID never compares equal to the argument
  # as typed and the check above can never have matched. Associated with a
  # routable address is the test that does not depend on how a name is spelled.
  state=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^wpa_state=//p') || true
  ssid=$(wpa_cli -i "$WIFI" status 2>/dev/null | sed -n 's/^ssid=//p') || true
  addr=$(ip -4 -o addr show dev "$WIFI" 2>/dev/null | awk '$4 !~ /^169\.254\./ {print $4; exit}') || true
  if [[ $state == COMPLETED && -n $addr ]]; then
    echo "rasputin: associated to \"$ssid\", $addr on $WIFI"
    echo "rasputin: (the supplicant spells that name differently from \"$want\" as typed)"
    portal_check || true
    echo "rasputin: declare a profile to use it: {{ rasputin_profiles.keys()|join(', ') }}"
    return 0
  fi
  die "\"$want\" did not associate.\n  check the name against what is on the air: rasputin join --scan\n  the block stays written and outranks the others until: rasputin forget \"$want\""
}

# 169.254/16 is not an address, it is dhcpcd giving up: it self-assigns one
# when the network answers no DHCP at all. Counting it as a lease reports a
# working uplink that fails on the first packet, and a venue is the worst place
# to learn that from a timeout. Only a routable address means we arrived.
wait_for_v4() {
  local ifc="$1" i addr
  for i in $(seq 1 20); do
    addr=$(ip -4 -o addr show dev "$ifc" 2>/dev/null | awk '$4 !~ /^169\.254\./ {print $4; exit}')
    [[ -n $addr ]] && { printf '%s' "$addr"; return 0; }
    sleep 1
  done
  return 1
}

# The SSID has to match what is broadcast exactly, and a typo does not fail
# loudly - the supplicant simply never associates and offers no reason. Taking
# the name off the air removes the guess.
wpa_scan() {
  # A scan is the first thing a venue hears from this box, and probe requests
  # carry the source address - so the identity is settled before the scan.
  shed_permanent_mac
  wpa_cli -i "$WIFI" scan >/dev/null 2>&1 || die "could not reach the supplicant on $WIFI"
  sleep 3
  # SSIDs are free to contain spaces, so the name goes last and everything
  # that has to line up in columns goes before it.
  wpa_cli -i "$WIFI" scan_results 2>/dev/null | awk -F'\t' '
    NR > 1 && NF >= 5 && $5 != "" {
      printf "%5s dBm  %-5s  %s\n", $3, ($4 ~ /WPA|RSN/ ? "WPA" : "open"), $5
    }' | sort -rn | uniq
}

forget_network() {
  local ssid="${1:-}" tmp
  [[ -n $ssid ]] || die "forget needs an SSID: rasputin forget <ssid>"
  (( $# <= 1 )) || die "forget takes one SSID. Quote a name with spaces in it."
  tmp=$(mktemp "${WPA_CONF}.rasputin.XXXXXX")
  # -x, so the fence must be the whole line: a substring test passes for
  # "Hotel" whenever "Hotel Annexe" is joined, then strips nothing and reports
  # success for a network it never touched.
  if grep -qxF "$(join_begin "$ssid")" "$WPA_CONF"; then
    wpa_strip_block "$ssid" "$WPA_CONF" > "$tmp"
  elif wpa_has_ssid_block "$ssid" "$WPA_CONF"; then
    echo "rasputin: \"$ssid\" has no rasputin fence - the supplicant rewrote this file"
    wpa_strip_ssid_block "$ssid" "$WPA_CONF" > "$tmp"
  else
    rm -f "$tmp"
    die "no network declaring \"$ssid\" is in $WPA_CONF"
  fi
  chmod 0600 "$tmp"; mv -f "$tmp" "$WPA_CONF"
  wpa_cli -i "$WIFI" reconfigure >/dev/null 2>&1 || true
  echo "rasputin: forgot \"$ssid\""
}

AVAHI_CONF=/etc/avahi/avahi-daemon.conf

# avahi announces this box - hostname, addresses, services - by multicast on
# every interface it is allowed to use. On a venue uplink that is a free
# inventory entry for anyone listening, and the firewall cannot help: these
# are packets we SEND, and the output chain only clamps down when a tunnel is
# up. Denying the venue-facing leg keeps .local working on our own AP while
# staying silent where it matters.
#
# {{ wan_wifi_if }} is denied unconditionally - it is a hardware invariant that
# it always faces the venue. {{ eth_if }} is denied only when it is the uplink.
write_avahi_deny() {
  local mode="$1" deny="$WIFI"
  [[ $mode == uplink ]] && deny="$WIFI,$ETH"
  [[ -f $AVAHI_CONF ]] || return 0
  if grep -qE '^[[:space:]]*deny-interfaces=' "$AVAHI_CONF"; then
    sed -i "s|^[[:space:]]*deny-interfaces=.*|deny-interfaces=$deny|" "$AVAHI_CONF"
  else
    sed -i "/^\[server\]/a deny-interfaces=$deny" "$AVAHI_CONF"
  fi
  systemctl restart avahi-daemon 2>/dev/null || true
  echo "rasputin: avahi silenced on $deny"
}

VPN_IF={{ vpn_interface }}
BLOCKY_LISTEN=/etc/blocky/config.d/20-listen.yml
BLOCKY_UPSTREAM=/etc/blocky/config.d/15-upstream.yml

# A profile is the unit of switching, and it has two axes: which leg faces the
# venue, and whether traffic may leave any way other than the tunnel.
# {{ eth_if }}'s role FOLLOWS from the first - a client when it is the uplink, a
# LAN leg otherwise - so MODE is derived here and never typed.
#
# The mode words from before profiles are still understood when READ, because
# a state file written back then may carry one and boot must not die on it.
# They are refused when TYPED: "serve" said which way {{ eth_if }} faced and
# nothing about the tunnel, and a box on venue wifi with no VPN deserves a name
# that says so.
profile_lookup() {
  PROFILE_NAME="$1"
  case "$1" in
{% for name, p in rasputin_profiles.items() %}
    {{ name }}) MODE={{ 'uplink' if p.uplink == eth_if else 'serve' }}; VPN={{ 1 if p.vpn else 0 }}; MACRAND={{ 1 if p.randomize_mac | default(true) else 0 }} ;;
{% endfor %}
{% for alias, target in legacy_profile_aliases.items() %}
    {{ alias }}) profile_lookup {{ target }} ;;
{% endfor %}
    *) return 1 ;;
  esac
}

resolve_profile() {
  profile_lookup "$1" || die "unknown profile: $1\n  known: {{ rasputin_profiles.keys()|join(' ') }}"
  [[ $PROFILE_NAME == "$1" ]] \
    || echo "rasputin: '$1' is a mode word from before profiles - reading it as '$PROFILE_NAME'" >&2
}

vpn_start() {
  ip link show "$VPN_IF" >/dev/null 2>&1 && return 0
  local out
  # Keep wg-quick's output: it names the actual failure (bad key, unresolvable
  # endpoint, missing conf) and there is nowhere else it gets logged.
  out=$(wg-quick up "$VPN_IF" 2>&1) \
    || die "VPN required by this profile but failed to start; refusing to continue unprotected\n$out"
  echo "rasputin: $VPN_IF up"
}

vpn_stop() {
  ip link show "$VPN_IF" >/dev/null 2>&1 || return 0
  wg-quick down "$VPN_IF" >/dev/null 2>&1 || true
  echo "rasputin: $VPN_IF down"
}

# --- captive portals --------------------------------------------------------
# Detection is DNS-free by construction, and it has to be: a portal breaks DNS
# FIRST. blocky's only upstream is DoH on :443, which is exactly what the
# portal intercepts, so anything needing a name to resolve cannot be the thing
# that notices the portal. This speaks HTTP/1.1 to a literal anycast address
# and supplies the Host header itself.
#
# 204-with-no-body is the agreed "you are online" answer, and a portal cannot
# give it: to show you a login page it must answer 200 or redirect.
#
# The User-Agent is deliberately dull. A portal intercepts :80, so whatever we
# send lands in the venue's logs - and a unique string there would identify
# this box across every venue it ever probes, which is the identity the MAC
# randomisation is spending effort to hide.
#
#   0  clear      1  portal (PORTAL_URL set)      2  no HTTP path at all
portal_probe() {
  PORTAL_URL=""
  local ip host path out code loc
  while read -r ip host path; do
    [[ -n "$ip" ]] || continue
    out=$(timeout 6 bash -c \
      'exec 3<>/dev/tcp/$1/80 || exit 1
       printf "GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\nUser-Agent: Mozilla/5.0\r\n\r\n" "$3" "$2" >&3
       head -c 4096 <&3' _ "$ip" "$host" "$path" 2>/dev/null) || continue
    code=$(printf '%s' "$out" | head -1 | awk '{print $2}')
    [[ $code == 204 ]] && return 0
    # The Location of the redirect IS the portal's login URL. It is the single
    # most useful thing to hand back, and the only way to learn it without DNS.
    loc=$(printf '%s' "$out" | grep -im1 '^location:' | cut -d: -f2- | tr -d '\r' | sed 's/^ *//')
    PORTAL_URL="${loc:-HTTP $code from $host}"
    return 1
  done <<'TARGETS'
{% for t in portal_probe_targets %}
{{ t.ip }} {{ t.host }} {{ t.path }}
{% endfor %}
TARGETS
  return 2
}

# The output chain is the half of the kill switch that stops THIS box leaking,
# and the portal probe is this box's own traffic. Probed through it, the answer
# can only ever be "no HTTP path", which converge then read as a dead uplink -
# and the operator was told "peer or key problem, not a portal" while standing
# behind a login page. Measured 2026-09-05, and it cost the whole first night.
#
# So the probe runs with the output chain open. Only the output chain: the
# forward chain is untouched, so clients stay exactly as restricted as they
# were. Whatever follows - apply_firewall in converge, reapply_firewall here -
# rebuilds the chain in full, so the opening lasts as long as the probe.
output_guard_open() {
  nft list chain inet rasputin output >/dev/null 2>&1 || return 0
  nft add chain inet rasputin output '{ type filter hook output priority 0; policy accept; }' 2>/dev/null || true
  nft flush chain inet rasputin output 2>/dev/null || true
}

portal_check() {
  local rc=0 reapply=0
  if nft list chain inet rasputin output 2>/dev/null | grep -q 'policy drop'; then
    reapply=1; output_guard_open
  fi
  portal_probe || rc=$?
  if (( reapply )); then
    reapply_firewall || echo "rasputin: WARNING - could not re-arm the output guard after the probe" >&2
  fi
  case $rc in
    0) echo "captive portal: none - this network is clear" ;;
    1) echo "captive portal: DETECTED"
       echo "                login page: $PORTAL_URL"
       echo "                clear it:   rasputin portal" ;;
    *) echo "captive portal: unknown - no HTTP path to any probe target."
       echo "                that is a dead uplink, not a portal" ;;
  esac
  return $rc
}

# The venue's own resolver, taken from the DHCP lease we already hold. Inside a
# captive portal this is the ONLY resolver that can answer: the portal is
# blocking the DoH upstream that would otherwise serve us.
venue_resolvers() {
  local ifc="$1" ns r out=""
  ns=$(dhcpcd -U "$ifc" 2>/dev/null | grep -m1 '^domain_name_servers=' | cut -d= -f2- | tr -d "'\"")
  for r in $ns; do
    [[ $r =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && out="$out $r"
  done
  # Falling back to the gateway is not a guess: on venue networks the box that
  # hands out the lease is nearly always the resolver too, and a network that
  # offers no resolver at all is one whose portal you cannot reach anyway.
  if [[ -z $out ]]; then
    r=$(ip -4 route show default dev "$ifc" 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
    [[ -n $r ]] && out=" $r"
  fi
  echo "${out# }"
}

# blocky's upstream half. rasputin owns this file for the same reason it owns
# 20-listen.yml - it is the half that changes - and it writes the WHOLE
# `upstreams` block every time, so there is never a question about how two
# config.d fragments merge. Keep in step with blocky-15-upstream.yml.j2.
write_blocky_upstream() {
  local portal="${1:-0}" resolvers="${2:-}" r
  mkdir -p "$(dirname "$BLOCKY_UPSTREAM")"
  {
    if [[ $portal == 1 ]]; then
      echo "# Managed by rasputin. CAPTIVE PORTAL MODE - PLAINTEXT DNS."
      echo "#"
      echo "# This is the one path the rest of this design forbids. It exists"
      echo "# because the portal blocks the DoH upstream that would otherwise"
      echo "# answer, which leaves the venue's own resolver as the only one"
      echo "# reachable. The portal timer forces a converge, and any converge"
      echo "# rewrites this file back to DoH - so it cannot be left behind."
    else
      echo "# Managed by rasputin. Every query leaves this box over DoH."
    fi
    echo "upstreams:"
    echo "  init:"
    # A travel router boots before it has an uplink; `blocking` would leave it
    # with no resolver at all until the venue's wifi came up.
    echo "    strategy: fast"
    echo "  groups:"
    echo "    default:"
    if [[ $portal == 1 ]]; then
      for r in $resolvers; do echo "      - $r"; done
    else
{% for u in blocky_upstreams %}
      echo "      - {{ u }}"
{% endfor %}
    fi
    echo "  strategy: {{ blocky_upstream_strategy }}"
    echo "  timeout: {{ blocky_upstream_timeout }}"
  } > "$BLOCKY_UPSTREAM"
}

# The marker carries its own expiry, so a reboot inside the window cannot lose
# the bound: converge re-arms the timer from it, or clears it if it has passed.
portal_expiry() { awk -F= '/^expires=/{print $2; exit}' "$PORTAL_STATE" 2>/dev/null; }

# Pure predicate. `status` calls it on every TUI tick, so it must not delete
# anything - reaping a stale marker is converge's job, below.
portal_active() {
  local exp
  [[ -f $PORTAL_STATE ]] || return 1
  exp=$(portal_expiry)
  [[ -n $exp ]] || return 1
  [[ $(date +%s) -lt $exp ]]
}

portal_arm_timer() {
  local secs="$1"
  systemctl stop rasputin-portal.timer 2>/dev/null || true
  systemctl reset-failed rasputin-portal.service 2>/dev/null || true
  systemd-run --quiet --unit=rasputin-portal --on-active="${secs}s" \
    /usr/local/sbin/rasputin portal-expire \
    || die "could not arm the portal timer; refusing to open the box with no way back"
}

portal_close() {
  rm -f "$PORTAL_STATE"
  systemctl stop rasputin-portal.timer 2>/dev/null || true
  systemctl reset-failed rasputin-portal.service 2>/dev/null || true
}

portal_open() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE - run: rasputin <profile>"
  local secs="${PORTAL_SECS:-$PORTAL_TIMEOUT}"
  case "$secs" in ''|*[!0-9]*) die "--for takes whole seconds, got: $secs" ;; esac
  [ "$secs" -ge 60 ] || die "--for must be at least 60s, got: $secs"

  # A new venue is a new identity, and the pin is what SURVIVES a venue - so it
  # goes before the MAC that this portal will authorise is chosen. And the one
  # address that must never be pinned is the permanent one: a portal login
  # then ties the venue to the hardware for the whole stay.
  rm -f "$MAC_PIN"
  shed_permanent_mac
  { echo "profile=$profile"
    echo "opened=$(date -Is)"
    echo "expires=$(( $(date +%s) + secs ))"
  } > "$PORTAL_STATE"

  converge
  profile=$(cat "$STATE" 2>/dev/null || echo "$profile")
  pin_uplink_mac "$PORTAL_UPLINK"

  echo ""
  echo "rasputin: CAPTIVE PORTAL MODE - $((secs / 60))m, then back to '$profile' on its own"
  echo "rasputin:   tunnel DOWN, DNS plaintext to the venue, clients limited to :80/:443"
  echo "rasputin:   join the AP, open any http:// page, complete the login"
  local rc=0
  portal_probe || rc=$?
  case $rc in
    0) echo "rasputin:   probe says this network is ALREADY CLEAR - run: rasputin $profile" ;;
    1) echo "rasputin:   login page: $PORTAL_URL" ;;
  esac
  echo "rasputin:   when you are through:  rasputin $profile"
  echo "rasputin:   (that keeps the MAC the portal authorised; mac-new drops it)"
}

# wg-quick "up" only creates the interface - it succeeds against a network that
# drops every packet it sends. A completed handshake is the only proof the
# tunnel actually reaches its peer, and a captive portal is the usual reason
# it does not.
wg_handshake_ok() {
  local secs="${1:-20}" i hs
  for i in $(seq 1 "$secs"); do
    hs=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
    [[ -n $hs && $hs != 0 ]] && return 0
    sleep 1
  done
  return 1
}

# Which addresses the resolver answers on. Specific addresses, never 0.0.0.0:
# the input chain refuses :53 from the uplink, but `rollback-fire` DELETES that
# table, and a wildcard bind would turn the lockout insurance into an open
# resolver on the venue's wifi.
#
# The upstream is NOT written here. It is the same DoH endpoint in every
# profile, and the kill switch is enforced by the output chain below - not, as
# it used to be, by pointing dnsmasq at a resolver that is only routable inside
# the tunnel. Keep this in step with blocky-20-listen.yml.j2 in the role.
write_blocky_listen() {
  local mode="$1" addrs
  addrs="127.0.0.1:53,${AP_NET}.1:53"
  [[ $mode == serve ]] && addrs="${addrs},${ETH_NET}.1:53"
  mkdir -p "$(dirname "$BLOCKY_LISTEN")"
  cat > "$BLOCKY_LISTEN" <<EOF
# Managed by rasputin. Mode: $mode
ports:
  dns: $addrs
{% if blocky_doh_cert is defined and blocky_doh_key is defined %}
  https: ${AP_NET}.1:{{ blocky_doh_port }}$([[ $mode == serve ]] && echo ",${ETH_NET}.1:{{ blocky_doh_port }}")
certFile: {{ blocky_doh_cert }}
keyFile: {{ blocky_doh_key }}
minTlsServeVersion: "1.3"
{% endif %}
EOF
}

converge() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE - run: rasputin <profile>"
  local MODE VPN MACRAND PROFILE_NAME; resolve_profile "$profile"
  # A mode word left in the state file is rewritten to the profile it means, so
  # status never has to print it again.
  if [[ $PROFILE_NAME != "$profile" ]]; then echo "$PROFILE_NAME" > "$STATE"; profile="$PROFILE_NAME"; fi
  local mode="$MODE"
  local portal=0
  # A marker whose window has passed is stale - reap it here rather than let a
  # boot converge re-enter portal mode from it. This is the only place that
  # deletes it on expiry, so `status` can stay a pure query.
  if [[ -f $PORTAL_STATE ]] && ! portal_active; then portal_close; fi
  # Portal mode overrides the profile's VPN, never its mode: {{ eth_if }} keeps
  # the role it already had, so the LAN does not renumber under its own clients
  # halfway through a login page.
  if portal_active; then
    portal=1; VPN=0
    local _left=$(( $(portal_expiry) - $(date +%s) ))
    # The transient timer does not survive a reboot but the marker does, so the
    # window is re-armed from the recorded expiry - never extended by it.
    portal_arm_timer "$_left"
    echo "rasputin: CAPTIVE PORTAL MODE - $(( _left / 60 ))m left, then back to '$profile'"
  fi
  local uplink; [[ $mode == serve ]] && uplink="$WIFI" || uplink="$ETH"
  PORTAL_UPLINK="$uplink"

  write_blocky_listen "$mode"
  write_avahi_deny "$mode"
  drop_stale_mac_pin

{% if randomize_client_mac | default(true) | bool %}
  # Whichever leg faces the venue gets a fresh identity on every converge -
  # arriving somewhere new is exactly when a new identity is wanted. LAN legs
  # are never touched: a changing MAC there would break client ARP caches.
  # The supplicant must NOT be running while the MAC changes. A live instance
  # holds its own copy of the config, reacts to the interface bounce, and
  # re-randomises over whatever was just set - measured on this hardware: the
  # pin was silently replaced. Stopped across the change, it holds.
  if [[ $MACRAND == 1 ]]; then
    if [[ "$uplink" == "$WIFI" ]]; then
      supplicant stop
      apply_uplink_mac "$uplink"
      supplicant start
      reassociate_wifi
    else
      apply_uplink_mac "$uplink"
    fi
  elif [[ "$uplink" == "$WIFI" ]]; then
    # Keeping an identity means turning off the SUPPLICANT's own per-ESS
    # randomisation, not merely skipping ours: mac_addr=1 hands the network a
    # new client at the next association whatever rasputin did. The conf is read
    # at startup only, so the setting costs a restart - taken solely when it
    # actually moves, because an unconditional one would drop the uplink on
    # every converge in order to change nothing.
    if wpa_randomisation_is 0; then
      echo "rasputin: $WIFI keeps the identity it has - this profile does not randomise"
    else
      supplicant stop
      set_wpa_randomisation 0
      supplicant start
      reassociate_wifi
    fi
  fi
{% endif %}

  write_dhcpcd_block "$mode"

  if [[ $mode == serve ]]; then
    install -m 0644 "$LAN_SOURCE" "$LAN_SNIPPET"
  else
    # eth0 is a client now; dnsmasq must not answer DHCP on it.
    rm -f "$LAN_SNIPPET"
  fi

  # Validate BEFORE touching the running service - the step RaspAP skips.
  dnsmasq --test || die "dnsmasq config invalid; nothing restarted"

  dhcpcd -k "$ETH" >/dev/null 2>&1 || true
  dhcpcd -n "$ETH" >/dev/null 2>&1 || systemctl restart dhcpcd

  # restart, never reload: a failed unit cannot be reloaded back to life.
  systemctl restart dnsmasq

  # --- the tunnel, and the gate in front of it ------------------------------
  # This sits AFTER the MAC change, the reassociation and the dhcpcd bounce,
  # because only now does the uplink actually carry traffic. Probing before
  # that tested the PREVIOUS venue's association and always came back dead.
  #
  # vpn_stop is unconditional so the probe below runs on a bare uplink:
  # wg-quick installs a default route into $VPN_IF, so with the tunnel up this
  # box cannot see the venue's portal at all - which is precisely the state we
  # are trying to diagnose.
  vpn_stop
  if [[ $VPN == 1 ]]; then
    output_guard_open
    local _rc=0; portal_probe || _rc=$?
    case $_rc in
      # Arming the kill switch around a tunnel that can never handshake locks
      # this box out of the one network it needs in order to log in. That is
      # the chicken-and-egg that used to cost a second device and a cloned MAC.
      #
      # Leaving fail-closed on the way out, because this die sits BEFORE
      # apply_firewall: at boot it otherwise left no table at all - no
      # masquerade for the house, and the admin plane answering on the venue's
      # own leg. A portal that expires overnight puts a morning reboot here.
      # vpn=1 with wg0 absent matches no forward rule, so the house is offline
      # rather than exposed, which is the right way round.
      1) write_blocky_upstream 0
         apply_firewall "$uplink" "$mode" 1 0 \
           || echo "rasputin: WARNING - could not install the fail-closed ruleset" >&2
         die "a CAPTIVE PORTAL is in the way, so $VPN_IF will never handshake.\n  login page: $PORTAL_URL\n  clear it first:  rasputin portal\n  then:            rasputin $profile" ;;
      2) echo "rasputin: WARNING - no HTTP path out $uplink at all - converging fail-closed" >&2 ;;
    esac
    vpn_start
    # wg-quick "up" only creates the interface; it succeeds against a network
    # that drops every packet it sends. A handshake is the only proof the peer
    # is reachable, and the probe above has already ruled out a portal.
    wg_handshake_ok 20 \
      || echo "rasputin: WARNING - no $VPN_IF handshake, but the network probed clear - peer or key problem, not a portal" >&2
  fi

  # Upstreams last: venue_resolvers reads the DHCP lease, and the lease is only
  # final after the MAC change, the reassociation and the dhcpcd bounce above.
  if [[ $portal == 1 ]]; then
    local _vres; _vres=$(venue_resolvers "$uplink")
    [[ -n $_vres ]] || echo "rasputin: WARNING - the venue handed out no resolver; the login page may not load" >&2
    write_blocky_upstream 1 "$_vres"
    echo "rasputin: DNS is PLAINTEXT to ${_vres:-<none>} while the portal is open"
  else
    write_blocky_upstream 0
  fi

  # The listen addresses just changed with the mode and blocky binds them at
  # startup, so without this it keeps answering on the addresses the PREVIOUS
  # mode had - or, switching the other way, never binds the new one at all.
  #
  # Validate first, the same guard rail dnsmasq gets. rasputin writes two of the
  # three config.d fragments, and a resolver that fails to start is the one
  # failure this box cannot absorb - so on bad config the OLD blocky is left
  # running rather than restarted into nothing.
  if /usr/local/bin/blocky validate --config /etc/blocky/config.d >/dev/null 2>&1; then
    systemctl restart blocky
  else
    echo "rasputin: WARNING - blocky config invalid; resolver NOT restarted, keeping the running one" >&2
    /usr/local/bin/blocky validate --config /etc/blocky/config.d 2>&1 | tail -3 >&2
  fi
  # dhcpcd may still be a second or two behind on the LAN address, and the unit
  # retries on failure, so wait for a real answer instead of trusting
  # is-active. A resolver that is "running" but not bound is the failure this
  # box can least afford.
  local _b
  for _b in $(seq 1 20); do
    /usr/local/bin/blocky healthcheck >/dev/null 2>&1 && break
    sleep 1
  done
  /usr/local/bin/blocky healthcheck >/dev/null 2>&1 \
    || echo "rasputin: WARNING - blocky is not answering on 127.0.0.1:53" >&2

  [[ -n "${ROLLBACK:-}" ]] && schedule_rollback "$ROLLBACK"
  if ! apply_firewall "$uplink" "$mode" "$VPN" "$portal"; then
    systemctl stop rasputin-rollback.timer 2>/dev/null || true
    die "firewall apply failed; rollback disarmed, previous ruleset left intact"
  fi
  sleep 2
  assert_sane "$mode"
  echo "rasputin: converged to '$profile' (mode=$mode uplink=$uplink egress=$([[ $VPN == 1 ]] && echo "$VPN_IF" || echo "$uplink")$([[ $portal == 1 ]] && echo " PORTAL"))"
}

# The uplink's address is not a constant. A phone hotspot re-issues on a fresh
# subnet every time it comes back, and a venue lease can land anywhere. That
# matters because apply_firewall bakes the CURRENT uplink subnet and gateway
# into the ruleset: the venue-lateral drop and the captive-portal exception are
# both literal addresses. Nothing re-ran it between boots, so this box spent
# seven hours dropping traffic to a subnet it had left and holding a portal
# exception open to a gateway that no longer existed - while the network it was
# actually on had neither.
#
# refresh re-applies the gate for the address the uplink has NOW and does
# nothing else: no MAC change, no reassociation, no service restart. That is
# what makes it cheap enough to hang off a DHCP event.
# The firewall for the profile as declared and the uplink as it is now. Shared
# by refresh and by anything that has to put the output guard back after
# opening it for a probe.
reapply_firewall() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE"
  local MODE VPN MACRAND PROFILE_NAME; resolve_profile "$profile"
  local portal=0
  if portal_active; then portal=1; VPN=0; fi
  local uplink; [[ $MODE == serve ]] && uplink="$WIFI" || uplink="$ETH"
  apply_firewall "$uplink" "$MODE" "$VPN" "$portal"
}

refresh() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE"
  local MODE VPN MACRAND PROFILE_NAME; resolve_profile "$profile"
  local portal=0
  if portal_active; then portal=1; VPN=0; fi
  local uplink; [[ $MODE == serve ]] && uplink="$WIFI" || uplink="$ETH"
  # The DHCP hook fires for every interface. Only the uplink's address is baked
  # into the ruleset, so a lease on a LAN leg is not a reason to rebuild it -
  # and the hook must not need to know which leg is the uplink to say so.
  if [[ -n ${REFRESH_IF:-} && $REFRESH_IF != "$uplink" ]]; then return 0; fi
  apply_firewall "$uplink" "$MODE" "$VPN" "$portal" \
    || die "firewall apply failed; previous ruleset left intact"
  flush_stale_nat
  echo "rasputin: firewall refreshed for $uplink $(ip -4 -o addr show dev "$uplink" | awk '{print $4}' | head -1)"
  # A new lease under a tunnel profile with no handshake is the shape of a
  # captive portal appearing under the box - a venue moved onto, or a login
  # that expired overnight. The kill switch is doing its job; say what to do.
  if [[ $VPN == 1 ]] && ! wg_handshake_ok 1; then
    echo "rasputin: WARNING - $VPN_IF has no handshake, so clients have no egress. A captive portal is the usual cause: rasputin portal --check" >&2
  fi
}

# Masquerade bindings outlive the address they were built from. When the uplink
# renumbers, every established flow keeps rewriting to the old source and the
# replies come back to nobody - the connection is not reset, it just stops, and
# a TCP entry sits there for days. It is why a resolver holding one long-lived
# DoH connection keeps timing out long after the link is healthy again.
#
# --src-nat, not -F: only the NAT'd flows carry a stale source. Flushing
# everything would take the admin SSH session on the LAN with it, which is the
# session you are using when you need this.
flush_stale_nat() {
  command -v conntrack >/dev/null 2>&1 || {
    echo "rasputin: WARNING - conntrack not installed; stale NAT bindings left to time out" >&2
    return 0
  }
  conntrack -D --src-nat >/dev/null 2>&1 || true
}

portal_status_line() {
  local exp
  if portal_active; then
    exp=$(portal_expiry)
    echo "OPEN - tunnel down, plaintext DNS, web only - closes in $(( (exp - $(date +%s)) / 60 ))m"
  elif [[ -f $PORTAL_STATE ]]; then
    # The window has passed but nothing has converged yet, so the ruleset on the
    # box is still the open one. Saying "closed" here would be a lie.
    echo "EXPIRED - still open until a converge runs; run: rasputin $(cat "$STATE" 2>/dev/null || echo serve)"
  else
    echo "closed"
  fi
}

mac_status_line() {
  local ifc="$1" cur p_if p_mac
  cur=$(cat "/sys/class/net/$ifc/address" 2>/dev/null || echo '?')
  # Three fields, the last of which is the SSID and may contain spaces. Reading
  # two glued the SSID onto the MAC and every pinned status read NOT APPLIED.
  if [[ -f $MAC_PIN ]] && read -r p_if p_mac _ < "$MAC_PIN" && [[ $p_if == "$ifc" ]]; then
    [[ $p_mac == "$cur" ]] && echo "$cur PINNED" || echo "$cur PIN $p_mac NOT APPLIED"
  # An unpinned MAC is no longer the same as a random one: a profile can decline
  # to randomise, and the supplicant's own setting is what decides whether the
  # next association takes a new address.
  elif [[ $ifc == "$WIFI" ]] && wpa_randomisation_is 0; then
    echo "$cur stable"
  else
    echo "$cur random"
  fi
}

upstream_status_line() {
  [[ -f $BLOCKY_UPSTREAM ]] || { echo "unknown - $BLOCKY_UPSTREAM absent"; return 0; }
  local ups; ups=$(awk '/^      - /{sub(/^      - /,""); printf "%s ", $0}' "$BLOCKY_UPSTREAM")
  if grep -q 'CAPTIVE PORTAL MODE' "$BLOCKY_UPSTREAM"; then
    echo "PLAINTEXT ${ups% } - portal mode"
  else
    echo "DoH ${ups% }"
  fi
}

status() {
  # The uplink is derived from the declared profile, not from the routing
  # table: with the tunnel up the default route names wg0, not the leg it rides.
  local MODE VPN MACRAND PROFILE_NAME smode=serve
  profile_lookup "$(cat "$STATE" 2>/dev/null)" && smode=$MODE
  local supl; [[ $smode == serve ]] && supl="$WIFI" || supl="$ETH"
  echo "profile       : $(cat "$STATE" 2>/dev/null || echo '<unset>')"
  echo "portal        : $(portal_status_line)"
  echo "vpn ($VPN_IF)    : $(ip link show "$VPN_IF" >/dev/null 2>&1 && echo UP || echo down)"
  echo "egress        : $(nft list chain inet rasputin postrouting 2>/dev/null | grep -oE 'oifname "[a-z0-9]+" masquerade' || echo none)"
  echo "dnsmasq (dhcp): $(systemctl is-active dnsmasq)"
  echo "blocky (dns)  : $(systemctl is-active blocky)"
  echo "dns upstream  : $(upstream_status_line)"
  echo "uplink mac    : $(mac_status_line "$supl")"
  echo "output guard  : $(nft list chain inet rasputin output 2>/dev/null | grep -oE 'policy (drop|accept)' | head -1 || echo none)"
  echo "hostapd       : $(systemctl is-active hostapd)"
  echo "lan snippet   : $([[ -f $LAN_SNIPPET ]] && echo present || echo absent)"
  echo "default route : $(ip route show default | tr '\n' ';' || echo none)"
  echo "masquerade    : $(nft -a list chain inet rasputin postrouting 2>/dev/null | grep -o 'oifname "[a-z0-9]*" masquerade' || echo none)"
  echo "admin ifaces  : $(nft list set inet rasputin admin_ifaces 2>/dev/null | tr -d '\n' | grep -oE 'elements = \{[^}]*\}' | tr -s ' ' || echo '<none - admin plane NOT restricted or table absent>')"
}

mkdir -p "$STATE_DIR"
ROLLBACK=""
PORTAL_SECS=""
PORTAL_CHECK=""
REFRESH_IF=""
JOIN_SCAN=""
ARGS=()
cmd="${1:-}"; shift || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rollback) ROLLBACK="${2:?--rollback needs seconds}"; shift 2 ;;
    --for)      PORTAL_SECS="${2:?--for needs seconds}"; shift 2 ;;
    --check)    PORTAL_CHECK=1; shift ;;
    --scan)     JOIN_SCAN=1; shift ;;
    --if)       REFRESH_IF="${2:?--if needs an interface}"; shift 2 ;;
    # join takes an SSID and a passphrase positionally, so bare words are now
    # operands rather than a mistake. Anything shaped like an option still is
    # one, and a mistyped flag must not be silently swallowed as an SSID.
    -*) die "unknown option: $1" ;;
    *)  ARGS+=("$1"); shift ;;
  esac
done

case "$cmd" in
{% for name in rasputin_profiles.keys() %}
  {{ name }})  echo {{ name }} > "$STATE"; portal_close; converge ;;
{% endfor %}
{% for alias, target in legacy_profile_aliases.items() %}
  {{ alias }}) die "'{{ alias }}' is a mode word, not a profile: it said which way {{ eth_if }} faced and nothing about the tunnel.\n  the profile that means the same:  rasputin {{ target }}\n  all profiles: {{ rasputin_profiles.keys()|join(' ') }}" ;;
{% endfor %}
  # Naming a profile is how you LEAVE portal mode. Bare `converge` is not:
  # that is what boot runs, and a reboot must not silently drop the window.
  converge) converge ;;
  refresh)  refresh ;;
  portal)   if [[ -n $PORTAL_CHECK ]]; then portal_check; else portal_open; fi ;;
  join)     if [[ -n $JOIN_SCAN ]]; then wpa_scan; else join_network "${ARGS[@]}"; fi ;;
  forget)   forget_network "${ARGS[@]}" ;;
  portal-expire)
    echo "rasputin: portal window expired - restoring '$(cat "$STATE" 2>/dev/null || echo '?')'" >&2
    portal_close; converge ;;
  ap-mac)   ap_mac_new ;;
  mac-new)  rm -f "$MAC_PIN"; echo "rasputin: MAC pin dropped - this converge takes a fresh identity"; converge ;;
  confirm)  cancel_rollback ;;
  rollback-fire) rollback_fire ;;
  status)   status ;;
  *) usage >&2; exit 1 ;;
esac
