#!/usr/bin/env bash
# netmode - declare which role {{ eth_if }} plays, then converge onto it.
#
#   netmode serve     {{ eth_if }} FEEDS the wired network - this is UniFi WAN
#   netmode uplink    {{ eth_if }} TAKES an address from the venue ethernet
#   netmode status    show declared vs actual
#   netmode converge  re-apply the declared mode (runs at boot)
#   netmode portal    open a bounded hole to clear a captive portal
#   netmode mac-new   drop the pinned uplink MAC, take a fresh identity
#
# Managed by Ansible. Edit the role, not this file.
set -euo pipefail

STATE_DIR=/etc/netmode
STATE="$STATE_DIR/mode"
PORTAL_STATE="$STATE_DIR/portal"
MAC_PIN="$STATE_DIR/mac-pin"
PORTAL_TIMEOUT={{ portal_timeout | default(900) }}
PORTAL_URL=""
PORTAL_UPLINK=""
ETH={{ eth_if }}
AP={{ ap_if }}
WIFI={{ wan_wifi_if }}
ETH_NET={{ eth_subnet }}
AP_NET={{ ap_subnet }}
LAN_SNIPPET=/etc/dnsmasq.d/30-eth0-lan.conf
LAN_SOURCE=/usr/local/share/netmode/30-eth0-lan.conf
DHCPCD=/etc/dhcpcd.conf
BEGIN='# >>> netmode managed >>>'
END='# <<< netmode managed <<<'

die() { printf 'netmode: %b\n' "$*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

# --- the declared state ----------------------------------------------------
write_dhcpcd_block() {
  local mode="$1" tmp
  tmp=$(mktemp)
  sed "/^${BEGIN}$/,/^${END}$/d" "$DHCPCD" > "$tmp"
  {
    echo "$BEGIN"
    echo "# Generated by netmode. Mode: $mode"
    echo ""
    echo "# ${WIFI} is always a client and is the only interface permitted a gateway."
    echo "interface ${WIFI}"
    echo "gateway"
    echo ""
    echo "# ${AP} is always the AP. Constant in both modes. LAN => never a gateway."
    echo "interface ${AP}"
    echo "static ip_address=${AP_NET}.1/24"
    echo "nogateway"
    echo ""
    if [[ $mode == serve ]]; then
      echo "# ${ETH} serves the wired net. Deliberately NO 'static routers=' line:"
      echo "# a self-pointing gateway here black-holes all forwarded traffic."
      echo "interface ${ETH}"
      echo "static ip_address=${ETH_NET}.1/24"
      echo "nogateway"
    else
      echo "# ${ETH} is the uplink: plain DHCP client, gateway accepted from the venue."
      echo "interface ${ETH}"
      echo "gateway"
    fi
    echo "$END"
  } >> "$tmp"
  install -m 0644 "$tmp" "$DHCPCD"; rm -f "$tmp"
}

# --- firewall -------------------------------------------------------------
# Admin (SSH) and DNS are bound to whatever is LAN *in this mode*, never to the
# uplink. On a travel router the uplink is hostile by definition.
apply_firewall() {
  local uplink="$1" mode="$2" vpn="${3:-0}" portal="${4:-0}" lan_list admin_list egress
  # THE KILL SWITCH. With the VPN up, the tunnel is the only permitted exit.
  # If wg0 disappears, no forward rule matches and policy drop takes over -
  # clients lose connectivity rather than silently egressing in the clear.
  if [[ $vpn == 1 ]]; then egress="$VPN_IF"; else egress="$uplink"; fi
  if [[ $mode == serve ]]; then lan_list="\"$ETH\", \"$AP\""; else lan_list="\"$AP\""; fi
  admin_list="$lan_list"
{% if admin_on_uplink | default(false) | bool %}
  admin_list="$admin_list, \"$uplink\""   # admin_on_uplink=true: EXPOSES SSH TO THE VENUE
{% endif %}

  sysctl -qw net.ipv4.ip_forward=1

  # Never accept Router Advertisements on a hostile uplink: a spoofed RA
  # installs an IPv6 default route + RDNSS, and RFC 6724 makes IPv6 win over
  # our IPv4 path. This is the highest-value attack on this box at a venue.
  # all/default matter as much as the uplink: with them left at 1 a rogue
  # client on our OWN LAN can RA us a default route. Demonstrated, not theory.
  sysctl -qw net.ipv6.conf.all.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.default.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.all.autoconf=0 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.accept_ra=0" 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.autoconf=0" 2>/dev/null || true
  # We do not advertise IPv6 to clients, so forwarding it would only create
  # a path with no return route. Explicit beats inherited.
  sysctl -qw net.ipv6.conf.all.forwarding=0 2>/dev/null || true

  # The venue's own subnet and gateway. Clients must not reach other guests,
  # but MUST still reach the gateway itself or captive-portal login is
  # impossible - portals almost always sit on a private address there.
  local upnet upgw lateral=""
  # Wait for the uplink to actually have an address. apply_firewall runs
  # milliseconds after dhcpcd is bounced, so without this the lookups return
  # empty on the COMMON path and every anti-lateral rule silently vanishes.
  local _i
  for _i in $(seq 1 15); do
    upnet=$(ip -4 -o addr show dev "$uplink" 2>/dev/null | awk '{print $4}' | head -1)
    [[ -n "$upnet" ]] && break
    sleep 1
  done
  # "$3" is the gateway only for "default via X dev Y". On a point-to-point
  # uplink (LTE/tether: "default dev wwan0 scope link") $3 is the INTERFACE
  # NAME, which nft then tries to resolve as a hostname and the load fails.
  upgw=$(ip -4 route show default dev "$uplink" 2>/dev/null \
         | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
  if [[ -n "$upnet" ]]; then
    # With the tunnel up there is no legitimate reason for a client to talk to
    # the venue gateway in the clear - the portal was completed before the VPN
    # came up. Leaving the exception open would be a hole straight through the
    # kill switch to a venue-controlled device.
    if [[ -n "$upgw" && $vpn != 1 ]]; then
      # Only the ports a captive portal needs. A blanket accept here would let
      # SMB and mDNS reach the venue's own gateway - the exact inventory leak
      # the discovery drops below exist to prevent.
      lateral="    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport { 80, 443 } accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw udp dport 53 accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport 53 accept
"
    elif [[ $vpn == 1 ]]; then
      echo "netmode: captive-portal exception withheld - the tunnel is up, so the portal is already done" >&2
    else
      echo "netmode: WARNING - no gateway on $uplink; captive portals will be unreachable" >&2
    fi
    lateral="${lateral}    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upnet drop"
  else
    echo "netmode: WARNING - $uplink has no address; venue-lateral rules NOT installed" >&2
  fi

  # Portal mode swaps the blanket "anything out the uplink" accept for a
  # web-only one. The venue-subnet drop above still stands, so the other guests
  # stay unreachable for the whole time the login page is open - the hole is in
  # what protocols may leave, never in who may be reached.
  local egress_rule="    iifname @lan_ifaces oifname \"$egress\" accept"
  if [[ $portal == 1 ]]; then
    egress_rule="    # CAPTIVE PORTAL MODE: web only, and only long enough to log in.
    iifname @lan_ifaces oifname \"$uplink\" tcp dport { 80, 443 } accept"
  fi
  # THE OTHER HALF OF THE KILL SWITCH. The forward chain stops CLIENTS leaking
  # when the tunnel drops; nothing stopped traffic this box originates itself.
  # That was survivable only while the resolver's upstream was an address that
  # exists solely inside the tunnel. It is a DoH endpoint on the public
  # internet now, so a dead wg0 would leave the resolver quietly querying it
  # out of the venue's uplink - the leak the client-side switch cannot see.
  local output_policy="accept" output_rules=""
{% if killswitch_restrict_output | default(true) | bool %}
  if [[ $vpn == 1 ]]; then
    local wgep wgip wgport
    # Read the peer from the LIVE interface, not the config file: wg-quick has
    # already resolved and applied it, and this cannot disagree with what the
    # kernel is actually sending to.
    wgep=$(wg show "$VPN_IF" endpoints 2>/dev/null | awk '{print $2}' | head -1)
    wgip=${wgep%:*}; wgport=${wgep##*:}
    # IPv4 only, and validated: an IPv6 endpoint arrives as [addr]:port and
    # would render an "ip daddr [2001:...]" rule that nft refuses to load.
    if [[ $wgip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ && $wgport =~ ^[0-9]+$ ]]; then
      output_policy="drop"
      output_rules="    oif lo accept
    ct state established,related accept
    oifname \"$VPN_IF\" accept
    oifname @lan_ifaces accept
    # The handshake that keeps the tunnel alive must survive the chain that
    # insists on the tunnel, or a single dropped keepalive is unrecoverable.
    oifname \"$uplink\" ip daddr $wgip udp dport $wgport accept
    # dhcpcd lease renewal on the venue's uplink.
    oifname \"$uplink\" udp sport 68 udp dport 67 accept
    icmp type { destination-unreachable, time-exceeded } accept"
    else
      # Fail open, loudly, rather than strand the box: we are already past
      # vpn_start, so dropping the handshake would kill the tunnel that the
      # forward chain requires and take everything with it.
      echo "netmode: WARNING - no usable $VPN_IF peer endpoint ($wgep); output kill switch NOT installed" >&2
    fi
  fi
{% endif %}
  cat > "$STATE_DIR/ruleset.nft" <<NFT
table inet netmode
delete table inet netmode
table inet netmode {
  set lan_ifaces   { type ifname; elements = { $lan_list } }
  set admin_ifaces { type ifname; elements = { $admin_list } }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    # Path MTU discovery must survive on every interface or large responses
    # hang - especially behind WireGuard.
    icmp type { destination-unreachable, time-exceeded } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

    # Neighbour discovery is required for IPv6 to function at all.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept

    # Answer pings only on our own LANs. On the venue's network we stay dark.
    iifname @lan_ifaces icmp type echo-request accept
    # nd-router-advert accepted NOWHERE: we are the router, we are never told a route.
    iifname @lan_ifaces icmpv6 type { echo-request, nd-router-solicit } accept
    # NOTE: nd-router-advert is deliberately NOT accepted on the uplink.

    # DHCP + DNS: LAN legs only. Never an open resolver on the venue's wifi.
    iifname @lan_ifaces udp dport { 67, 53 } accept
    iifname @lan_ifaces tcp dport 53 accept
{% if blocky_doh_cert is defined and blocky_doh_key is defined %}
    # DoH, under exactly the same LAN-only rule as plain DNS. Binding the
    # listener is not enough - without this the input policy silently drops it
    # and the port looks open from the box but dead from every client.
    iifname @lan_ifaces tcp dport {{ blocky_doh_port }} accept
{% endif %}

    # DHCP client on the uplink. dhcpcd's initial handshake uses AF_PACKET and
    # bypasses netfilter, but broadcast replies and its UDP fallback do not.
    iifname "$uplink" udp sport 67 udp dport 68 accept

    # Admin plane.
    iifname @admin_ifaces tcp dport 22 accept
    # everything else, notably anything arriving on the uplink, hits policy drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    # MUST sit above the ct rule: the server's SYN-ACK is already ESTABLISHED,
    # so below it only the client's SYN gets clamped and the return direction
    # stays unclamped - half-fixing the blackhole this exists to prevent.
    tcp flags syn tcp option maxseg size set rt mtu
    ct state established,related accept
    ct state invalid drop
    # Lateral movement: reach the venue gateway (captive portal) but not the
    # other guests sharing that subnet.
$lateral
    iifname @lan_ifaces oifname "$uplink" ip daddr 169.254.0.0/16 drop

    # Unicast discovery only. Multicast never enters the forward hook at all
    # (no multicast routing), so these catch unicast mDNS/SSDP/NetBIOS - a
    # narrower leak than it looks, but a real one.
    iifname @lan_ifaces oifname "$uplink" udp dport { 5353, 5355, 1900, 137, 138 } drop
    iifname @lan_ifaces oifname "$uplink" tcp dport { 139, 445 } drop

$egress_rule
    iifname @lan_ifaces oifname @lan_ifaces accept
    # uplink -> LAN is only ever reply traffic, matched by the ct rule above
  }

  chain postrouting {
    type nat hook postrouting priority srcnat;
    oifname "$egress" masquerade
  }

  # Router-originated traffic. Wide open unless the profile demands a tunnel,
  # in which case wg0 is the only way out for this box too.
  chain output {
    type filter hook output priority 0; policy $output_policy;
$output_rules
  }
}
NFT

  # RaspAP left a blanket "-A POSTROUTING -j MASQUERADE" in the ip nat table.
  # It NATs out WHATEVER interface traffic takes, so the moment a tunnel drops
  # clients keep browsing straight out the venue's wifi, unprotected. A kill
  # switch cannot work while it exists. Docker's own rule is scoped with -s and
  # is left alone; we only remove unscoped blanket rules.
  while iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null; do
    iptables -t nat -D POSTROUTING -j MASQUERADE || break
    echo "netmode: removed a blanket iptables MASQUERADE (kill-switch prerequisite)"
  done

  # Validate before loading. A bad ruleset must never reach the kernel.
  if ! nft -c -f "$STATE_DIR/ruleset.nft"; then
    echo "netmode: nftables ruleset invalid; firewall unchanged" >&2
    return 1
  fi
  nft -f "$STATE_DIR/ruleset.nft"
}

# --- the guard that today's outage earned ----------------------------------
assert_sane() {
  local mode="$1" lans=() bad=0
  if [[ $mode == serve ]]; then lans=("$ETH" "$AP"); else lans=("$AP"); fi
  for lan in "${lans[@]}"; do
    if ip route show default | grep -q "dev ${lan}\b"; then
      echo "netmode: FATAL - default route points out LAN interface ${lan}" >&2
      bad=1
    fi
  done
  [[ $bad -eq 0 ]] || die "refusing to leave the box in a black-holed state"
  ip route show default | grep -q . || echo "netmode: WARNING - no default route at all"
}

# --- lockout insurance ------------------------------------------------------
# Tightening the admin plane remotely can strand you. Schedule a transient
# timer that tears the firewall back down; `netmode confirm` cancels it.
schedule_rollback() {
  local secs="$1"
  # Must be whole seconds. "--rollback 5m" would otherwise reach systemd as
  # --on-active=5ms and revert the firewall before it had finished applying.
  case "$secs" in ''|*[!0-9]*) die "--rollback takes whole seconds, got: $secs" ;; esac
  [ "$secs" -ge 30 ] || die "--rollback must be at least 30s, got: $secs"

  # A pending timer would make systemd-run fail on the unit name, aborting a
  # converge that has already rewritten dhcpcd and dnsmasq.
  systemctl stop netmode-rollback.timer 2>/dev/null || true
  systemctl reset-failed netmode-rollback.service 2>/dev/null || true
  rm -f "$STATE_DIR/rollback-fired"

  systemd-run --quiet --unit=netmode-rollback --on-active="${secs}s" \
    /usr/local/sbin/netmode rollback-fire \
    || die "could not schedule rollback; refusing to change the firewall blind"
  echo "netmode: firewall rolls back in ${secs}s - run 'netmode confirm' to keep it"
}

# Runs from the timer. Leaves a marker so `confirm` can distinguish "never
# armed" from "already fired and destroyed your firewall".
rollback_fire() {
  nft delete table inet netmode 2>/dev/null || true
  date -Is > "$STATE_DIR/rollback-fired"
  echo "netmode: ROLLBACK FIRED - firewall removed" >&2
}

cancel_rollback() {
  if [[ -f "$STATE_DIR/rollback-fired" ]]; then
    echo "netmode: ROLLBACK ALREADY FIRED at $(cat "$STATE_DIR/rollback-fired")" >&2
    echo "netmode: the firewall was removed. Re-run 'netmode $(cat "$STATE" 2>/dev/null || echo serve)' to restore it." >&2
    return 1
  fi
  if systemctl stop netmode-rollback.timer 2>/dev/null; then
    echo "netmode: rollback cancelled, ruleset kept"
  else
    echo "netmode: no rollback was pending"
  fi
}

# A locally-administered, unicast MAC. Only ever applied to the interface
# facing the venue - never to a LAN leg, where a changing MAC would break
# every client's ARP cache and our own DHCP reservations.
set_mac() {
  local ifc="$1" mac="$2" rc=0
  ip link set dev "$ifc" down 2>/dev/null || true
  ip link set dev "$ifc" address "$mac" 2>/dev/null || rc=1
  ip link set dev "$ifc" up 2>/dev/null || true
  return $rc
}

randomize_mac() {
  local ifc="$1" mac
  mac=$(printf '02:%02x:%02x:%02x:%02x:%02x' \
        $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
  if set_mac "$ifc" "$mac"; then
    echo "netmode: $ifc MAC randomised to $mac"
  else
    echo "netmode: WARNING - could not randomise MAC on $ifc" >&2
  fi
}

WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf

# wpa_supplicant applies its OWN per-ESS randomisation (mac_addr=1) at
# association time, and it overwrites whatever `ip link set address` put there.
# Proven on this hardware: a converge set 02:c7:fc:e9:3d:56 and the interface
# came up wearing 8a:db:56:49:f7:6f. So holding a MAC means turning that off
# for as long as the pin lasts, and turning it back on when the pin is dropped.
# With mac_addr=0 the supplicant leaves an externally-set address alone - it
# does NOT restore the permanent one, which was the risk worth testing.
set_wpa_randomisation() {
  local want="$1"   # 1 = supplicant randomises per ESS; 0 = netmode owns the MAC
  [[ -f $WPA_CONF ]] || return 0
  # Delete-then-insert rather than substitute: Ansible writes this line too, and
  # a config carrying both mac_addr=0 and mac_addr=1 is ambiguous about which
  # wins. Collapsing to exactly one is the point, not just setting the value.
  [[ $(grep -c '^mac_addr=' "$WPA_CONF") -eq 1 ]] \
    && grep -q "^mac_addr=${want}$" "$WPA_CONF" && return 0
  sed -i '/^mac_addr=/d' "$WPA_CONF"
  sed -i "1i mac_addr=${want}" "$WPA_CONF"
}

# A captive portal authorises a MAC ADDRESS, not a person. Randomising on the
# converge that follows would throw away the login you just completed, so
# `netmode portal` pins whatever MAC cleared the portal and every converge
# after it holds that MAC until `netmode mac-new` releases it. With no pin
# this is the old behaviour exactly: arriving somewhere is when a new identity
# is wanted, and every converge takes one.
apply_uplink_mac() {
  local ifc="$1" p_if p_mac
  if [[ -f $MAC_PIN ]] && read -r p_if p_mac < "$MAC_PIN" && [[ $p_if == "$ifc" ]]; then
    # Must happen before reassociate_wifi restarts the supplicant, or the
    # supplicant re-randomises and the pin is silently discarded.
    [[ $ifc == "$WIFI" ]] && set_wpa_randomisation 0
    if set_mac "$ifc" "$p_mac"; then
      echo "netmode: $ifc MAC held at $p_mac (pinned - a portal authorised it)"
      return 0
    fi
    echo "netmode: WARNING - could not restore pinned MAC $p_mac on $ifc" >&2
  fi
  [[ $ifc == "$WIFI" ]] && set_wpa_randomisation 1
  randomize_mac "$ifc"
}

pin_uplink_mac() {
  local ifc="$1" mac
  mac=$(cat "/sys/class/net/$ifc/address" 2>/dev/null) || return 0
  echo "$ifc $mac" > "$MAC_PIN"
  echo "netmode: $ifc MAC $mac pinned - 'netmode mac-new' takes a fresh one"
}

# Both halves of the MAC story live here. wpa_supplicant's mac_addr=1 DOES work
# on this hardware (measured), so it, not `ip link set address`, is what
# normally decides the address - netmode only takes over when a pin is held.
# The INSTANCE unit owns the association (-c ...-wlan0.conf -i wlan0). On this
# image the plain wpa_supplicant.service is the D-Bus daemon (-u -s -O) and
# touching it does not affect wlan0 at all.
supplicant() {
  systemctl "$1" "wpa_supplicant@${WIFI}" 2>/dev/null \
    || systemctl "$1" wpa_supplicant 2>/dev/null || true
}

# Waits for the supplicant to associate AND take a lease. The MAC is only
# settled once associated: preassoc_mac_addr=1 randomises during the scan, so
# sampling earlier reports an address the interface is about to stop wearing.
reassociate_wifi() {
  local i
  for i in $(seq 1 {{ wifi_reassociate_timeout | default(45) }}); do
    if [[ -n "$(ip -4 -o addr show dev "$WIFI" 2>/dev/null)" ]]; then
      echo "netmode: $WIFI reassociated as $(cat /sys/class/net/$WIFI/address)"
      return 0
    fi
    dhcpcd -n "$WIFI" >/dev/null 2>&1 || true
    sleep 1
  done
  echo "netmode: WARNING - $WIFI has no address after MAC change" >&2
}

AVAHI_CONF=/etc/avahi/avahi-daemon.conf

# avahi announces this box - hostname, addresses, services - by multicast on
# every interface it is allowed to use. On a venue uplink that is a free
# inventory entry for anyone listening, and the firewall cannot help: these
# are packets we SEND, and the output chain only clamps down when a tunnel is
# up. Denying the venue-facing leg keeps .local working on our own AP while
# staying silent where it matters.
#
# {{ wan_wifi_if }} is denied unconditionally - it is a hardware invariant that
# it always faces the venue. {{ eth_if }} is denied only when it is the uplink.
write_avahi_deny() {
  local mode="$1" deny="$WIFI"
  [[ $mode == uplink ]] && deny="$WIFI,$ETH"
  [[ -f $AVAHI_CONF ]] || return 0
  if grep -qE '^[[:space:]]*deny-interfaces=' "$AVAHI_CONF"; then
    sed -i "s|^[[:space:]]*deny-interfaces=.*|deny-interfaces=$deny|" "$AVAHI_CONF"
  else
    sed -i "/^\[server\]/a deny-interfaces=$deny" "$AVAHI_CONF"
  fi
  systemctl restart avahi-daemon 2>/dev/null || true
  echo "netmode: avahi silenced on $deny"
}

VPN_IF={{ vpn_interface }}
BLOCKY_LISTEN=/etc/blocky/config.d/20-listen.yml
BLOCKY_UPSTREAM=/etc/blocky/config.d/15-upstream.yml

# A profile is the unit of switching. MODE decides eth0's role, VPN decides
# whether traffic may leave any way other than the tunnel.
resolve_profile() {
  case "$1" in
{% for name, p in netmode_profiles.items() %}
    {{ name }}) MODE={{ p.mode }}; VPN={{ 1 if p.vpn else 0 }} ;;
{% endfor %}
    serve|lan)   MODE=serve;  VPN=0 ;;
    uplink|wan)  MODE=uplink; VPN=0 ;;
    *) die "unknown profile: $1\n  known: {{ netmode_profiles.keys()|join(' ') }} serve uplink" ;;
  esac
}

vpn_start() {
  ip link show "$VPN_IF" >/dev/null 2>&1 && return 0
  local out
  # Keep wg-quick's output: it names the actual failure (bad key, unresolvable
  # endpoint, missing conf) and there is nowhere else it gets logged.
  out=$(wg-quick up "$VPN_IF" 2>&1) \
    || die "VPN required by this profile but failed to start; refusing to continue unprotected\n$out"
  echo "netmode: $VPN_IF up"
}

vpn_stop() {
  ip link show "$VPN_IF" >/dev/null 2>&1 || return 0
  wg-quick down "$VPN_IF" >/dev/null 2>&1 || true
  echo "netmode: $VPN_IF down"
}

# --- captive portals --------------------------------------------------------
# Detection is DNS-free by construction, and it has to be: a portal breaks DNS
# FIRST. blocky's only upstream is DoH on :443, which is exactly what the
# portal intercepts, so anything needing a name to resolve cannot be the thing
# that notices the portal. This speaks HTTP/1.1 to a literal anycast address
# and supplies the Host header itself.
#
# 204-with-no-body is the agreed "you are online" answer, and a portal cannot
# give it: to show you a login page it must answer 200 or redirect.
#
#   0  clear      1  portal (PORTAL_URL set)      2  no HTTP path at all
portal_probe() {
  PORTAL_URL=""
  local ip host path out code loc
  while read -r ip host path; do
    [[ -n "$ip" ]] || continue
    out=$(timeout 6 bash -c \
      'exec 3<>/dev/tcp/$1/80 || exit 1
       printf "GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\nUser-Agent: netmode\r\n\r\n" "$3" "$2" >&3
       head -c 4096 <&3' _ "$ip" "$host" "$path" 2>/dev/null) || continue
    code=$(printf '%s' "$out" | head -1 | awk '{print $2}')
    [[ $code == 204 ]] && return 0
    # The Location of the redirect IS the portal's login URL. It is the single
    # most useful thing to hand back, and the only way to learn it without DNS.
    loc=$(printf '%s' "$out" | grep -im1 '^location:' | cut -d: -f2- | tr -d '\r' | sed 's/^ *//')
    PORTAL_URL="${loc:-HTTP $code from $host}"
    return 1
  done <<'TARGETS'
{% for t in portal_probe_targets %}
{{ t.ip }} {{ t.host }} {{ t.path }}
{% endfor %}
TARGETS
  return 2
}

portal_check() {
  local rc=0
  portal_probe || rc=$?
  case $rc in
    0) echo "captive portal: none - this network is clear" ;;
    1) echo "captive portal: DETECTED"
       echo "                login page: $PORTAL_URL"
       echo "                clear it:   netmode portal" ;;
    *) echo "captive portal: unknown - no HTTP path to any probe target."
       echo "                that is a dead uplink, not a portal" ;;
  esac
  return $rc
}

# The venue's own resolver, taken from the DHCP lease we already hold. Inside a
# captive portal this is the ONLY resolver that can answer: the portal is
# blocking the DoH upstream that would otherwise serve us.
venue_resolvers() {
  local ifc="$1" ns r out=""
  ns=$(dhcpcd -U "$ifc" 2>/dev/null | grep -m1 '^domain_name_servers=' | cut -d= -f2- | tr -d "'\"")
  for r in $ns; do
    [[ $r =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && out="$out $r"
  done
  # Falling back to the gateway is not a guess: on venue networks the box that
  # hands out the lease is nearly always the resolver too, and a network that
  # offers no resolver at all is one whose portal you cannot reach anyway.
  if [[ -z $out ]]; then
    r=$(ip -4 route show default dev "$ifc" 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
    [[ -n $r ]] && out=" $r"
  fi
  echo "${out# }"
}

# blocky's upstream half. netmode owns this file for the same reason it owns
# 20-listen.yml - it is the half that changes - and it writes the WHOLE
# `upstreams` block every time, so there is never a question about how two
# config.d fragments merge. Keep in step with blocky-15-upstream.yml.j2.
write_blocky_upstream() {
  local portal="${1:-0}" resolvers="${2:-}" r
  mkdir -p "$(dirname "$BLOCKY_UPSTREAM")"
  {
    if [[ $portal == 1 ]]; then
      echo "# Managed by netmode. CAPTIVE PORTAL MODE - PLAINTEXT DNS."
      echo "#"
      echo "# This is the one path the rest of this design forbids. It exists"
      echo "# because the portal blocks the DoH upstream that would otherwise"
      echo "# answer, which leaves the venue's own resolver as the only one"
      echo "# reachable. The portal timer forces a converge, and any converge"
      echo "# rewrites this file back to DoH - so it cannot be left behind."
    else
      echo "# Managed by netmode. Every query leaves this box over DoH."
    fi
    echo "upstreams:"
    echo "  init:"
    # A travel router boots before it has an uplink; `blocking` would leave it
    # with no resolver at all until the venue's wifi came up.
    echo "    strategy: fast"
    echo "  groups:"
    echo "    default:"
    if [[ $portal == 1 ]]; then
      for r in $resolvers; do echo "      - $r"; done
    else
{% for u in blocky_upstreams %}
      echo "      - {{ u }}"
{% endfor %}
    fi
    echo "  strategy: strict"
    echo "  timeout: {{ blocky_upstream_timeout }}"
  } > "$BLOCKY_UPSTREAM"
}

# The marker carries its own expiry, so a reboot inside the window cannot lose
# the bound: converge re-arms the timer from it, or clears it if it has passed.
portal_expiry() { awk -F= '/^expires=/{print $2; exit}' "$PORTAL_STATE" 2>/dev/null; }

# Pure predicate. `status` calls it on every TUI tick, so it must not delete
# anything - reaping a stale marker is converge's job, below.
portal_active() {
  local exp
  [[ -f $PORTAL_STATE ]] || return 1
  exp=$(portal_expiry)
  [[ -n $exp ]] || return 1
  [[ $(date +%s) -lt $exp ]]
}

portal_arm_timer() {
  local secs="$1"
  systemctl stop netmode-portal.timer 2>/dev/null || true
  systemctl reset-failed netmode-portal.service 2>/dev/null || true
  systemd-run --quiet --unit=netmode-portal --on-active="${secs}s" \
    /usr/local/sbin/netmode portal-expire \
    || die "could not arm the portal timer; refusing to open the box with no way back"
}

portal_close() {
  rm -f "$PORTAL_STATE"
  systemctl stop netmode-portal.timer 2>/dev/null || true
  systemctl reset-failed netmode-portal.service 2>/dev/null || true
}

portal_open() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE - run: netmode <profile>"
  local secs="${PORTAL_SECS:-$PORTAL_TIMEOUT}"
  case "$secs" in ''|*[!0-9]*) die "--for takes whole seconds, got: $secs" ;; esac
  [ "$secs" -ge 60 ] || die "--for must be at least 60s, got: $secs"

  # A new venue is a new identity, and the pin is what SURVIVES a venue - so it
  # goes before the MAC that this portal will authorise is chosen.
  rm -f "$MAC_PIN"
  { echo "profile=$profile"
    echo "opened=$(date -Is)"
    echo "expires=$(( $(date +%s) + secs ))"
  } > "$PORTAL_STATE"

  converge
  pin_uplink_mac "$PORTAL_UPLINK"

  echo ""
  echo "netmode: CAPTIVE PORTAL MODE - $((secs / 60))m, then back to '$profile' on its own"
  echo "netmode:   tunnel DOWN, DNS plaintext to the venue, clients limited to :80/:443"
  echo "netmode:   join the AP, open any http:// page, complete the login"
  local rc=0
  portal_probe || rc=$?
  case $rc in
    0) echo "netmode:   probe says this network is ALREADY CLEAR - run: netmode $profile" ;;
    1) echo "netmode:   login page: $PORTAL_URL" ;;
  esac
  echo "netmode:   when you are through:  netmode $profile"
  echo "netmode:   (that keeps the MAC the portal authorised; mac-new drops it)"
}

# wg-quick "up" only creates the interface - it succeeds against a network that
# drops every packet it sends. A completed handshake is the only proof the
# tunnel actually reaches its peer, and a captive portal is the usual reason
# it does not.
wg_handshake_ok() {
  local secs="${1:-20}" i hs
  for i in $(seq 1 "$secs"); do
    hs=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
    [[ -n $hs && $hs != 0 ]] && return 0
    sleep 1
  done
  return 1
}

# Which addresses the resolver answers on. Specific addresses, never 0.0.0.0:
# the input chain refuses :53 from the uplink, but `rollback-fire` DELETES that
# table, and a wildcard bind would turn the lockout insurance into an open
# resolver on the venue's wifi.
#
# The upstream is NOT written here. It is the same DoH endpoint in every
# profile, and the kill switch is enforced by the output chain below - not, as
# it used to be, by pointing dnsmasq at a resolver that is only routable inside
# the tunnel. Keep this in step with blocky-20-listen.yml.j2 in the role.
write_blocky_listen() {
  local mode="$1" addrs
  addrs="127.0.0.1:53,${AP_NET}.1:53"
  [[ $mode == serve ]] && addrs="${addrs},${ETH_NET}.1:53"
  mkdir -p "$(dirname "$BLOCKY_LISTEN")"
  cat > "$BLOCKY_LISTEN" <<EOF
# Managed by netmode. Mode: $mode
ports:
  dns: $addrs
{% if blocky_doh_cert is defined and blocky_doh_key is defined %}
  https: ${AP_NET}.1:{{ blocky_doh_port }}$([[ $mode == serve ]] && echo ",${ETH_NET}.1:{{ blocky_doh_port }}")
certFile: {{ blocky_doh_cert }}
keyFile: {{ blocky_doh_key }}
minTlsServeVersion: "1.3"
{% endif %}
EOF
}

converge() {
  local profile; profile=$(cat "$STATE" 2>/dev/null) || die "no declared profile at $STATE - run: netmode <profile>"
  local MODE VPN; resolve_profile "$profile"
  local mode="$MODE"
  local portal=0
  # A marker whose window has passed is stale - reap it here rather than let a
  # boot converge re-enter portal mode from it. This is the only place that
  # deletes it on expiry, so `status` can stay a pure query.
  if [[ -f $PORTAL_STATE ]] && ! portal_active; then portal_close; fi
  # Portal mode overrides the profile's VPN, never its mode: {{ eth_if }} keeps
  # the role it already had, so the LAN does not renumber under its own clients
  # halfway through a login page.
  if portal_active; then
    portal=1; VPN=0
    local _left=$(( $(portal_expiry) - $(date +%s) ))
    # The transient timer does not survive a reboot but the marker does, so the
    # window is re-armed from the recorded expiry - never extended by it.
    portal_arm_timer "$_left"
    echo "netmode: CAPTIVE PORTAL MODE - $(( _left / 60 ))m left, then back to '$profile'"
  fi
  local uplink; [[ $mode == serve ]] && uplink="$WIFI" || uplink="$ETH"
  PORTAL_UPLINK="$uplink"

  write_blocky_listen "$mode"
  write_avahi_deny "$mode"

{% if randomize_client_mac | default(true) | bool %}
  # Whichever leg faces the venue gets a fresh identity on every converge -
  # arriving somewhere new is exactly when a new identity is wanted. LAN legs
  # are never touched: a changing MAC there would break client ARP caches.
  # The supplicant must NOT be running while the MAC changes. A live instance
  # holds its own copy of the config, reacts to the interface bounce, and
  # re-randomises over whatever was just set - measured on this hardware: the
  # pin was silently replaced. Stopped across the change, it holds.
  if [[ "$uplink" == "$WIFI" ]]; then
    supplicant stop
    apply_uplink_mac "$uplink"
    supplicant start
    reassociate_wifi
  else
    apply_uplink_mac "$uplink"
  fi
{% endif %}

  write_dhcpcd_block "$mode"

  if [[ $mode == serve ]]; then
    install -m 0644 "$LAN_SOURCE" "$LAN_SNIPPET"
  else
    # eth0 is a client now; dnsmasq must not answer DHCP on it.
    rm -f "$LAN_SNIPPET"
  fi

  # Validate BEFORE touching the running service - the step RaspAP skips.
  dnsmasq --test || die "dnsmasq config invalid; nothing restarted"

  dhcpcd -k "$ETH" >/dev/null 2>&1 || true
  dhcpcd -n "$ETH" >/dev/null 2>&1 || systemctl restart dhcpcd

  # restart, never reload: a failed unit cannot be reloaded back to life.
  systemctl restart dnsmasq

  # --- the tunnel, and the gate in front of it ------------------------------
  # This sits AFTER the MAC change, the reassociation and the dhcpcd bounce,
  # because only now does the uplink actually carry traffic. Probing before
  # that tested the PREVIOUS venue's association and always came back dead.
  #
  # vpn_stop is unconditional so the probe below runs on a bare uplink:
  # wg-quick installs a default route into $VPN_IF, so with the tunnel up this
  # box cannot see the venue's portal at all - which is precisely the state we
  # are trying to diagnose.
  vpn_stop
  if [[ $VPN == 1 ]]; then
    local _rc=0; portal_probe || _rc=$?
    case $_rc in
      # Arming the kill switch around a tunnel that can never handshake locks
      # this box out of the one network it needs in order to log in. That is
      # the chicken-and-egg that used to cost a second device and a cloned MAC.
      1) die "a CAPTIVE PORTAL is in the way, so $VPN_IF will never handshake.\n  login page: $PORTAL_URL\n  clear it first:  netmode portal\n  then:            netmode $profile" ;;
      2) echo "netmode: WARNING - no HTTP path out $uplink at all - converging fail-closed" >&2 ;;
    esac
    vpn_start
    # wg-quick "up" only creates the interface; it succeeds against a network
    # that drops every packet it sends. A handshake is the only proof the peer
    # is reachable, and the probe above has already ruled out a portal.
    wg_handshake_ok 20 \
      || echo "netmode: WARNING - no $VPN_IF handshake, but the network probed clear - peer or key problem, not a portal" >&2
  fi

  # Upstreams last: venue_resolvers reads the DHCP lease, and the lease is only
  # final after the MAC change, the reassociation and the dhcpcd bounce above.
  if [[ $portal == 1 ]]; then
    local _vres; _vres=$(venue_resolvers "$uplink")
    [[ -n $_vres ]] || echo "netmode: WARNING - the venue handed out no resolver; the login page may not load" >&2
    write_blocky_upstream 1 "$_vres"
    echo "netmode: DNS is PLAINTEXT to ${_vres:-<none>} while the portal is open"
  else
    write_blocky_upstream 0
  fi

  # The listen addresses just changed with the mode and blocky binds them at
  # startup, so without this it keeps answering on the addresses the PREVIOUS
  # mode had - or, switching the other way, never binds the new one at all.
  #
  # Validate first, the same guard rail dnsmasq gets. netmode writes two of the
  # three config.d fragments, and a resolver that fails to start is the one
  # failure this box cannot absorb - so on bad config the OLD blocky is left
  # running rather than restarted into nothing.
  if /usr/local/bin/blocky validate --config /etc/blocky/config.d >/dev/null 2>&1; then
    systemctl restart blocky
  else
    echo "netmode: WARNING - blocky config invalid; resolver NOT restarted, keeping the running one" >&2
    /usr/local/bin/blocky validate --config /etc/blocky/config.d 2>&1 | tail -3 >&2
  fi
  # dhcpcd may still be a second or two behind on the LAN address, and the unit
  # retries on failure, so wait for a real answer instead of trusting
  # is-active. A resolver that is "running" but not bound is the failure this
  # box can least afford.
  local _b
  for _b in $(seq 1 20); do
    /usr/local/bin/blocky healthcheck >/dev/null 2>&1 && break
    sleep 1
  done
  /usr/local/bin/blocky healthcheck >/dev/null 2>&1 \
    || echo "netmode: WARNING - blocky is not answering on 127.0.0.1:53" >&2

  [[ -n "${ROLLBACK:-}" ]] && schedule_rollback "$ROLLBACK"
  if ! apply_firewall "$uplink" "$mode" "$VPN" "$portal"; then
    systemctl stop netmode-rollback.timer 2>/dev/null || true
    die "firewall apply failed; rollback disarmed, previous ruleset left intact"
  fi
  sleep 2
  assert_sane "$mode"
  echo "netmode: converged to '$profile' (mode=$mode uplink=$uplink egress=$([[ $VPN == 1 ]] && echo "$VPN_IF" || echo "$uplink")$([[ $portal == 1 ]] && echo " PORTAL"))"
}

portal_status_line() {
  local exp
  if portal_active; then
    exp=$(portal_expiry)
    echo "OPEN - tunnel down, plaintext DNS, web only - closes in $(( (exp - $(date +%s)) / 60 ))m"
  elif [[ -f $PORTAL_STATE ]]; then
    # The window has passed but nothing has converged yet, so the ruleset on the
    # box is still the open one. Saying "closed" here would be a lie.
    echo "EXPIRED - still open until a converge runs; run: netmode $(cat "$STATE" 2>/dev/null || echo serve)"
  else
    echo "closed"
  fi
}

mac_status_line() {
  local ifc="$1" cur p_if p_mac
  cur=$(cat "/sys/class/net/$ifc/address" 2>/dev/null || echo '?')
  if [[ -f $MAC_PIN ]] && read -r p_if p_mac < "$MAC_PIN" && [[ $p_if == "$ifc" ]]; then
    [[ $p_mac == "$cur" ]] && echo "$cur PINNED" || echo "$cur PIN $p_mac NOT APPLIED"
  else
    echo "$cur random"
  fi
}

upstream_status_line() {
  [[ -f $BLOCKY_UPSTREAM ]] || { echo "unknown - $BLOCKY_UPSTREAM absent"; return 0; }
  local ups; ups=$(awk '/^      - /{sub(/^      - /,""); printf "%s ", $0}' "$BLOCKY_UPSTREAM")
  if grep -q 'CAPTIVE PORTAL MODE' "$BLOCKY_UPSTREAM"; then
    echo "PLAINTEXT ${ups% } - portal mode"
  else
    echo "DoH ${ups% }"
  fi
}

status() {
  # The uplink is derived from the declared profile, not from the routing
  # table: with the tunnel up the default route names wg0, not the leg it rides.
  local smode=serve
  case "$(cat "$STATE" 2>/dev/null)" in
{% for name, p in netmode_profiles.items() %}
    {{ name }}) smode={{ p.mode }} ;;
{% endfor %}
    uplink|wan) smode=uplink ;;
  esac
  local supl; [[ $smode == serve ]] && supl="$WIFI" || supl="$ETH"
  echo "profile       : $(cat "$STATE" 2>/dev/null || echo '<unset>')"
  echo "portal        : $(portal_status_line)"
  echo "vpn ($VPN_IF)    : $(ip link show "$VPN_IF" >/dev/null 2>&1 && echo UP || echo down)"
  echo "egress        : $(nft list chain inet netmode postrouting 2>/dev/null | grep -oE 'oifname "[a-z0-9]+" masquerade' || echo none)"
  echo "dnsmasq (dhcp): $(systemctl is-active dnsmasq)"
  echo "blocky (dns)  : $(systemctl is-active blocky)"
  echo "dns upstream  : $(upstream_status_line)"
  echo "uplink mac    : $(mac_status_line "$supl")"
  echo "output guard  : $(nft list chain inet netmode output 2>/dev/null | grep -oE 'policy (drop|accept)' | head -1 || echo none)"
  echo "hostapd       : $(systemctl is-active hostapd)"
  echo "lan snippet   : $([[ -f $LAN_SNIPPET ]] && echo present || echo absent)"
  echo "default route : $(ip route show default | tr '\n' ';' || echo none)"
  echo "masquerade    : $(nft -a list chain inet netmode postrouting 2>/dev/null | grep -o 'oifname "[a-z0-9]*" masquerade' || echo none)"
  echo "admin ifaces  : $(nft list set inet netmode admin_ifaces 2>/dev/null | tr -d '\n' | grep -oE 'elements = \{[^}]*\}' | tr -s ' ' || echo '<none - admin plane NOT restricted or table absent>')"
}

mkdir -p "$STATE_DIR"
ROLLBACK=""
PORTAL_SECS=""
PORTAL_CHECK=""
cmd="${1:-}"; shift || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rollback) ROLLBACK="${2:?--rollback needs seconds}"; shift 2 ;;
    --for)      PORTAL_SECS="${2:?--for needs seconds}"; shift 2 ;;
    --check)    PORTAL_CHECK=1; shift ;;
    *) die "unknown option: $1" ;;
  esac
done

# Names describe which way eth0 FACES, not whose WAN it is. "wan" was
# ambiguous: eth0 being "the WAN for UniFi" means eth0 SERVES. Old names
# remain as aliases so muscle memory keeps working.
case "$cmd" in
{% for name in netmode_profiles.keys() %}
  {{ name }})  echo {{ name }} > "$STATE"; portal_close; converge ;;
{% endfor %}
  serve|lan)   echo serve  > "$STATE"; portal_close; converge ;;
  uplink|wan)  echo uplink > "$STATE"; portal_close; converge ;;
  # Naming a profile is how you LEAVE portal mode. Bare `converge` is not:
  # that is what boot runs, and a reboot must not silently drop the window.
  converge) converge ;;
  portal)   if [[ -n $PORTAL_CHECK ]]; then portal_check; else portal_open; fi ;;
  portal-expire)
    echo "netmode: portal window expired - restoring '$(cat "$STATE" 2>/dev/null || echo '?')'" >&2
    portal_close; converge ;;
  mac-new)  rm -f "$MAC_PIN"; echo "netmode: MAC pin dropped - this converge takes a fresh identity"; converge ;;
  confirm)  cancel_rollback ;;
  rollback-fire) rollback_fire ;;
  status)   status ;;
  *) die "usage: netmode {{'{'}}{{ netmode_profiles.keys()|join('|') }}|serve|uplink|converge|confirm|status|portal|mac-new{{'}'}}\n              [--rollback SECS] [--for SECS] [--check]\n  serve   = {{ eth_if }} FEEDS the wired net (this is UniFi WAN)\n  uplink  = {{ eth_if }} TAKES an address from the venue\n  portal  = open a bounded hole to clear a captive portal (--check only probes)\n  mac-new = drop the pinned uplink MAC and take a fresh identity" ;;
esac
