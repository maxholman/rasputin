#!/usr/bin/env bash
# netmode - declare which role {{ eth_if }} plays, then converge onto it.
#
#   netmode serve   {{ eth_if }} FEEDS the wired network - this is UniFi WAN
#   netmode uplink  {{ eth_if }} TAKES an address from the venue ethernet
#   netmode status  show declared vs actual
#   netmode converge  re-apply the declared mode (runs at boot)
#
# Managed by Ansible. Edit the role, not this file.
set -euo pipefail

STATE_DIR=/etc/netmode
STATE="$STATE_DIR/mode"
ETH={{ eth_if }}
AP={{ ap_if }}
WIFI={{ wan_wifi_if }}
ETH_NET={{ eth_subnet }}
AP_NET={{ ap_subnet }}
LAN_SNIPPET=/etc/dnsmasq.d/30-eth0-lan.conf
LAN_SOURCE=/usr/local/share/netmode/30-eth0-lan.conf
DHCPCD=/etc/dhcpcd.conf
BEGIN='# >>> netmode managed >>>'
END='# <<< netmode managed <<<'

die() { printf 'netmode: %b\n' "$*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

# --- the declared state ----------------------------------------------------
write_dhcpcd_block() {
  local mode="$1" tmp
  tmp=$(mktemp)
  sed "/^${BEGIN}$/,/^${END}$/d" "$DHCPCD" > "$tmp"
  {
    echo "$BEGIN"
    echo "# Generated by netmode. Mode: $mode"
    echo ""
    echo "# ${WIFI} is always a client and is the only interface permitted a gateway."
    echo "interface ${WIFI}"
    echo "gateway"
    echo ""
    echo "# ${AP} is always the AP. Constant in both modes. LAN => never a gateway."
    echo "interface ${AP}"
    echo "static ip_address=${AP_NET}.1/24"
    echo "nogateway"
    echo ""
    if [[ $mode == serve ]]; then
      echo "# ${ETH} serves the wired net. Deliberately NO 'static routers=' line:"
      echo "# a self-pointing gateway here black-holes all forwarded traffic."
      echo "interface ${ETH}"
      echo "static ip_address=${ETH_NET}.1/24"
      echo "nogateway"
    else
      echo "# ${ETH} is the uplink: plain DHCP client, gateway accepted from the venue."
      echo "interface ${ETH}"
      echo "gateway"
    fi
    echo "$END"
  } >> "$tmp"
  install -m 0644 "$tmp" "$DHCPCD"; rm -f "$tmp"
}

# --- firewall -------------------------------------------------------------
# Admin (SSH) and DNS are bound to whatever is LAN *in this mode*, never to the
# uplink. On a travel router the uplink is hostile by definition.
apply_firewall() {
  local uplink="$1" mode="$2" lan_list admin_list
  if [[ $mode == serve ]]; then lan_list="\"$ETH\", \"$AP\""; else lan_list="\"$AP\""; fi
  admin_list="$lan_list"
{% if admin_on_uplink | default(false) | bool %}
  admin_list="$admin_list, \"$uplink\""   # admin_on_uplink=true: EXPOSES SSH TO THE VENUE
{% endif %}

  sysctl -qw net.ipv4.ip_forward=1

  # Never accept Router Advertisements on a hostile uplink: a spoofed RA
  # installs an IPv6 default route + RDNSS, and RFC 6724 makes IPv6 win over
  # our IPv4 path. This is the highest-value attack on this box at a venue.
  # all/default matter as much as the uplink: with them left at 1 a rogue
  # client on our OWN LAN can RA us a default route. Demonstrated, not theory.
  sysctl -qw net.ipv6.conf.all.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.default.accept_ra=0 2>/dev/null || true
  sysctl -qw net.ipv6.conf.all.autoconf=0 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.accept_ra=0" 2>/dev/null || true
  sysctl -qw "net.ipv6.conf.${uplink}.autoconf=0" 2>/dev/null || true
  # We do not advertise IPv6 to clients, so forwarding it would only create
  # a path with no return route. Explicit beats inherited.
  sysctl -qw net.ipv6.conf.all.forwarding=0 2>/dev/null || true

  # The venue's own subnet and gateway. Clients must not reach other guests,
  # but MUST still reach the gateway itself or captive-portal login is
  # impossible - portals almost always sit on a private address there.
  local upnet upgw lateral=""
  # Wait for the uplink to actually have an address. apply_firewall runs
  # milliseconds after dhcpcd is bounced, so without this the lookups return
  # empty on the COMMON path and every anti-lateral rule silently vanishes.
  local _i
  for _i in $(seq 1 15); do
    upnet=$(ip -4 -o addr show dev "$uplink" 2>/dev/null | awk '{print $4}' | head -1)
    [[ -n "$upnet" ]] && break
    sleep 1
  done
  # "$3" is the gateway only for "default via X dev Y". On a point-to-point
  # uplink (LTE/tether: "default dev wwan0 scope link") $3 is the INTERFACE
  # NAME, which nft then tries to resolve as a hostname and the load fails.
  upgw=$(ip -4 route show default dev "$uplink" 2>/dev/null \
         | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
  if [[ -n "$upnet" ]]; then
    if [[ -n "$upgw" ]]; then
      # Only the ports a captive portal needs. A blanket accept here would let
      # SMB and mDNS reach the venue's own gateway - the exact inventory leak
      # the discovery drops below exist to prevent.
      lateral="    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport { 80, 443 } accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw udp dport 53 accept
    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upgw tcp dport 53 accept
"
    else
      echo "netmode: WARNING - no gateway on $uplink; captive portals will be unreachable" >&2
    fi
    lateral="${lateral}    iifname @lan_ifaces oifname \"$uplink\" ip daddr $upnet drop"
  else
    echo "netmode: WARNING - $uplink has no address; venue-lateral rules NOT installed" >&2
  fi
  cat > "$STATE_DIR/ruleset.nft" <<NFT
table inet netmode
delete table inet netmode
table inet netmode {
  set lan_ifaces   { type ifname; elements = { $lan_list } }
  set admin_ifaces { type ifname; elements = { $admin_list } }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    # Path MTU discovery must survive on every interface or large responses
    # hang - especially behind WireGuard.
    icmp type { destination-unreachable, time-exceeded } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

    # Neighbour discovery is required for IPv6 to function at all.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept

    # Answer pings only on our own LANs. On the venue's network we stay dark.
    iifname @lan_ifaces icmp type echo-request accept
    # nd-router-advert accepted NOWHERE: we are the router, we are never told a route.
    iifname @lan_ifaces icmpv6 type { echo-request, nd-router-solicit } accept
    # NOTE: nd-router-advert is deliberately NOT accepted on the uplink.

    # DHCP + DNS: LAN legs only. Never an open resolver on the venue's wifi.
    iifname @lan_ifaces udp dport { 67, 53 } accept
    iifname @lan_ifaces tcp dport 53 accept

    # DHCP client on the uplink. dhcpcd's initial handshake uses AF_PACKET and
    # bypasses netfilter, but broadcast replies and its UDP fallback do not.
    iifname "$uplink" udp sport 67 udp dport 68 accept

    # Admin plane.
    iifname @admin_ifaces tcp dport 22 accept
    # everything else, notably anything arriving on the uplink, hits policy drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    # MUST sit above the ct rule: the server's SYN-ACK is already ESTABLISHED,
    # so below it only the client's SYN gets clamped and the return direction
    # stays unclamped - half-fixing the blackhole this exists to prevent.
    tcp flags syn tcp option maxseg size set rt mtu
    ct state established,related accept
    ct state invalid drop
    # Lateral movement: reach the venue gateway (captive portal) but not the
    # other guests sharing that subnet.
$lateral
    iifname @lan_ifaces oifname "$uplink" ip daddr 169.254.0.0/16 drop

    # Unicast discovery only. Multicast never enters the forward hook at all
    # (no multicast routing), so these catch unicast mDNS/SSDP/NetBIOS - a
    # narrower leak than it looks, but a real one.
    iifname @lan_ifaces oifname "$uplink" udp dport { 5353, 5355, 1900, 137, 138 } drop
    iifname @lan_ifaces oifname "$uplink" tcp dport { 139, 445 } drop

    iifname @lan_ifaces oifname "$uplink" accept
    iifname @lan_ifaces oifname @lan_ifaces accept
    # uplink -> LAN is only ever reply traffic, matched by the ct rule above
  }

  chain postrouting {
    type nat hook postrouting priority srcnat;
    oifname "$uplink" masquerade
  }
}
NFT

  # Validate before loading. A bad ruleset must never reach the kernel.
  if ! nft -c -f "$STATE_DIR/ruleset.nft"; then
    echo "netmode: nftables ruleset invalid; firewall unchanged" >&2
    return 1
  fi
  nft -f "$STATE_DIR/ruleset.nft"
}

# --- the guard that today's outage earned ----------------------------------
assert_sane() {
  local mode="$1" lans=() bad=0
  if [[ $mode == serve ]]; then lans=("$ETH" "$AP"); else lans=("$AP"); fi
  for lan in "${lans[@]}"; do
    if ip route show default | grep -q "dev ${lan}\b"; then
      echo "netmode: FATAL - default route points out LAN interface ${lan}" >&2
      bad=1
    fi
  done
  [[ $bad -eq 0 ]] || die "refusing to leave the box in a black-holed state"
  ip route show default | grep -q . || echo "netmode: WARNING - no default route at all"
}

# --- lockout insurance ------------------------------------------------------
# Tightening the admin plane remotely can strand you. Schedule a transient
# timer that tears the firewall back down; `netmode confirm` cancels it.
schedule_rollback() {
  local secs="$1"
  # Must be whole seconds. "--rollback 5m" would otherwise reach systemd as
  # --on-active=5ms and revert the firewall before it had finished applying.
  case "$secs" in ''|*[!0-9]*) die "--rollback takes whole seconds, got: $secs" ;; esac
  [ "$secs" -ge 30 ] || die "--rollback must be at least 30s, got: $secs"

  # A pending timer would make systemd-run fail on the unit name, aborting a
  # converge that has already rewritten dhcpcd and dnsmasq.
  systemctl stop netmode-rollback.timer 2>/dev/null || true
  systemctl reset-failed netmode-rollback.service 2>/dev/null || true
  rm -f "$STATE_DIR/rollback-fired"

  systemd-run --quiet --unit=netmode-rollback --on-active="${secs}s" \
    /usr/local/sbin/netmode rollback-fire \
    || die "could not schedule rollback; refusing to change the firewall blind"
  echo "netmode: firewall rolls back in ${secs}s - run 'netmode confirm' to keep it"
}

# Runs from the timer. Leaves a marker so `confirm` can distinguish "never
# armed" from "already fired and destroyed your firewall".
rollback_fire() {
  nft delete table inet netmode 2>/dev/null || true
  date -Is > "$STATE_DIR/rollback-fired"
  echo "netmode: ROLLBACK FIRED - firewall removed" >&2
}

cancel_rollback() {
  if [[ -f "$STATE_DIR/rollback-fired" ]]; then
    echo "netmode: ROLLBACK ALREADY FIRED at $(cat "$STATE_DIR/rollback-fired")" >&2
    echo "netmode: the firewall was removed. Re-run 'netmode $(cat "$STATE" 2>/dev/null || echo serve)' to restore it." >&2
    return 1
  fi
  if systemctl stop netmode-rollback.timer 2>/dev/null; then
    echo "netmode: rollback cancelled, ruleset kept"
  else
    echo "netmode: no rollback was pending"
  fi
}

converge() {
  local mode; mode=$(cat "$STATE" 2>/dev/null) || die "no declared mode at $STATE - run: netmode serve|uplink"
  [[ $mode == serve || $mode == uplink ]] || die "bad declared mode: $mode"
  local uplink; [[ $mode == serve ]] && uplink="$WIFI" || uplink="$ETH"

  write_dhcpcd_block "$mode"

  if [[ $mode == serve ]]; then
    install -m 0644 "$LAN_SOURCE" "$LAN_SNIPPET"
  else
    # eth0 is a client now; dnsmasq must not answer DHCP on it.
    rm -f "$LAN_SNIPPET"
  fi

  # Validate BEFORE touching the running service - the step RaspAP skips.
  dnsmasq --test || die "dnsmasq config invalid; nothing restarted"

  dhcpcd -k "$ETH" >/dev/null 2>&1 || true
  dhcpcd -n "$ETH" >/dev/null 2>&1 || systemctl restart dhcpcd

  # restart, never reload: a failed unit cannot be reloaded back to life.
  systemctl restart dnsmasq

  [[ -n "${ROLLBACK:-}" ]] && schedule_rollback "$ROLLBACK"
  if ! apply_firewall "$uplink" "$mode"; then
    systemctl stop netmode-rollback.timer 2>/dev/null || true
    die "firewall apply failed; rollback disarmed, previous ruleset left intact"
  fi
  sleep 2
  assert_sane "$mode"
  echo "netmode: converged to '$mode' (uplink=$uplink)"
}

status() {
  echo "declared mode : $(cat "$STATE" 2>/dev/null || echo '<unset>')"
  echo "dnsmasq       : $(systemctl is-active dnsmasq)"
  echo "hostapd       : $(systemctl is-active hostapd)"
  echo "lan snippet   : $([[ -f $LAN_SNIPPET ]] && echo present || echo absent)"
  echo "default route : $(ip route show default | tr '\n' ';' || echo none)"
  echo "masquerade    : $(nft -a list chain inet netmode postrouting 2>/dev/null | grep -o 'oifname "[a-z0-9]*" masquerade' || echo none)"
  echo "admin ifaces  : $(nft list set inet netmode admin_ifaces 2>/dev/null | grep -o 'elements = {.*}' || echo none)"
}

mkdir -p "$STATE_DIR"
ROLLBACK=""
cmd="${1:-}"; shift || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rollback) ROLLBACK="${2:?--rollback needs seconds}"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

# Names describe which way eth0 FACES, not whose WAN it is. "wan" was
# ambiguous: eth0 being "the WAN for UniFi" means eth0 SERVES. Old names
# remain as aliases so muscle memory keeps working.
case "$cmd" in
  serve|lan)   echo serve  > "$STATE"; converge ;;
  uplink|wan)  echo uplink > "$STATE"; converge ;;
  converge) converge ;;
  confirm)  cancel_rollback ;;
  rollback-fire) rollback_fire ;;
  status)   status ;;
  *) die "usage: netmode {serve|uplink|converge|confirm|status} [--rollback SECS]\n  serve  = eth0 FEEDS the wired net (this is UniFi WAN)\n  uplink = eth0 TAKES an address from the venue" ;;
esac
