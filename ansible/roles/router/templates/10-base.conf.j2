# Base dnsmasq policy. Managed by Ansible.
#
# dnsmasq is the DHCP server, and a resolver for exactly one purpose: the split
# domains. blocky owns :53 and forwards those names here; this answers them
# from the resolver inside the split tunnel and records every address in the
# nftables set that steers their traffic - see 50-split-dns.conf. Nothing else
# asks it anything, and it listens for DNS on loopback only.
#
# Known loss: DHCP lease names do not resolve, because the resolver that knows
# the leases is not the one clients ask.
port={{ split_dns_port }}
listen-address=127.0.0.1
# No resolv.conf: that names blocky, and blocky forwards here. A loop.
no-resolv
no-hosts

log-facility=/var/log/dnsmasq.log
conf-dir=/etc/dnsmasq.d
domain-needed
bogus-priv

# `interface=` alone does NOT prevent dnsmasq answering elsewhere: without this
# it opens a wildcard socket and becomes an open resolver on the venue's wifi.
# bind-dynamic (not bind-interfaces) so it copes with interfaces coming up late.
bind-dynamic
except-interface={{ wan_wifi_if }}
no-dhcp-interface={{ wan_wifi_if }}
